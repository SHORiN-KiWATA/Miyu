# FreeBSD port for Miyu.
# The CARGO_CRATES block below was generated from Cargo.lock at release time;
# regenerate it and run `make makesum` on a FreeBSD machine after version bumps.

PORTNAME=	amiyu
DISTVERSION=	0.4.6
CATEGORIES=	deskutils

MAINTAINER=	shorin@users.noreply.github.com
COMMENT=	Terminal-native AI assistant with messaging-platform integration
WWW=		https://github.com/SHORiN-KiWATA/Miyu

LICENSE=	MIT
LICENSE_FILE=	${WRKSRC}/LICENSE

ONLY_FOR_ARCHS=	aarch64 amd64

USES=		cargo
USE_GITHUB=	yes
GH_ACCOUNT=	SHORiN-KiWATA
GH_PROJECT=	Miyu
GH_TAGNAME=	v${DISTVERSION}

# rodio/cpal only speak ALSA; FreeBSD's audio/alsa-lib translates onto OSS.
LIB_DEPENDS=	libasound.so:audio/alsa-lib
RUN_DEPENDS=	rg:textproc/ripgrep \
		chafa:graphics/chafa

PLIST_FILES=	bin/miyu
# Full share/ listing is generated with `make makeplist` on first build;
# the directories below cover the staged assets.
PLIST_DIRS=	share/miyu/fonts \
		share/miyu/memes \
		share/miyu/scripts \
		share/miyu/default-kb

post-install:
	${MKDIR} ${STAGEDIR}${PREFIX}/share/miyu/fonts
	${INSTALL_DATA} ${WRKSRC}/assets/fonts/NotoSansCJK-Regular.ttc \
		${WRKSRC}/assets/fonts/NotoColorEmoji.ttf \
		${WRKSRC}/assets/fonts/NotoSansCJK.LICENSE \
		${WRKSRC}/assets/fonts/NotoColorEmoji.LICENSE \
		${STAGEDIR}${PREFIX}/share/miyu/fonts
	cd ${WRKSRC}/src/memes && ${COPYTREE_SHARE} . \
		${STAGEDIR}${PREFIX}/share/miyu/memes
	cd ${WRKSRC}/src/scripts && ${COPYTREE_SHARE} . \
		${STAGEDIR}${PREFIX}/share/miyu/scripts
	${MKDIR} ${STAGEDIR}${PREFIX}/share/miyu/default-kb
	cd ${WRKSRC}/kb && ${COPYTREE_SHARE} . \
		${STAGEDIR}${PREFIX}/share/miyu/default-kb

