# ---------------------------------------------------------------- Miyu stdin-JSON 模式

def stdin_json_mode(raw):
    """Miyu script 工具入口: 无命令行参数且 stdin 不是终端时启用。
    输入: {"action":"search|note|status", "query":"...", "limit":N, ...}
    输出: 纯 JSON(stdout), 进度静默。"""
    global QUIET
    QUIET = True

    def die(msg, extra=None):
        out = {"error": msg}
        if extra:
            out.update(extra)
        print(json.dumps(out, ensure_ascii=False))
        sys.exit(1)

    try:
        req = json.loads(raw)
    except Exception:
        die("stdin 不是有效 JSON")

    if not isinstance(req, dict):
        die("stdin 的 JSON 得是一个对象", {"example": {"query": "手冲咖啡", "limit": 10}})

    # 拼错的参数**必须**报错, 不能默默用默认值: 这脚本每次搜索都烧一次账号级的
    # 日频配额, "跑完了才发现 sort 拼错、结果按综合排的"等于白烧一次, 还得出错结论。
    known = {"action", "query", "keyword", "url", "limit", "sort", "type", "comments"}
    unknown = [k for k in req if k not in known]
    if unknown:
        die(f"不认识这些参数: {', '.join(map(repr, sorted(unknown)))}",
            {"known": sorted(known)})

    query = str(req.get("query") or req.get("keyword") or req.get("url") or "").strip()
    limit = req.get("limit", req.get("comments"))
    # action 可以不传: 链接/note_id → 看正文, 其余 → 搜索
    action = str(req.get("action") or ("note" if looks_like_note(query) else "search")).strip()
    valid = ("search", "note", "status")
    if action not in valid:
        die(f"未知 action: {action} (可选 {' / '.join(valid)})")
    if action != "status" and not query:
        die("query 参数缺失")

    sort = str(req.get("sort") or "综合").strip()
    ntype = str(req.get("type") or "全部").strip()
    if sort not in SORTS:
        die(f"未知 sort: {sort!r}", {"known": list(SORTS)})
    if ntype not in TYPES:
        die(f"未知 type: {ntype!r}", {"known": list(TYPES)})
    try:
        limit = int(limit) if limit is not None else None
    except (TypeError, ValueError):
        die(f"limit 得是整数, 收到 {req.get('limit')!r}")

    good, probs = preflight()
    if not good:
        die("依赖未就绪", {"problems": probs,
                          "fix": "运行 xhs-search setup 自动安装",
                          "doctor": doctor_text()})
    try:
        if action == "status":
            out = do_status()
        elif action == "search":
            out = do_search(query, max(1, min(limit or 20, 100)), sort, ntype)
        else:
            out = do_note(query, max(0, min(limit or 0, 100)))
    except NotLoggedIn as e:
        die(str(e), {"fix": f"运行: {login_command_hint('xhs-search')}（会给出二维码）"})
    except RuntimeError as e:
        die(str(e))
    except Exception as e:
        die(f"执行失败: {e}", {"doctor": doctor_text()})
    print(json.dumps(out, ensure_ascii=False, indent=1))


# ---------------------------------------------------------------- 渲染

def render(data, as_json, kind):
    if as_json:
        print(json.dumps(data, ensure_ascii=False, indent=1))
        return
    if kind == "search":
        head = f"共 {data['count']} 条 · 关键词: {data['keyword']} · 排序: {data['sort']}"
        if data.get("degraded"):
            head += f"(要的是 {data['sort_requested']}/{data['type_requested']})"
        print(head)
        for n in data["notes"]:
            print(f"赞{n['liked']:<7} 藏{n['collected']:<7} 评{n['comments']:<6} {n['title'][:38]}")
            print(f"  {n['author']} · {n['url']}")
    elif kind == "note":
        print(f"{data['title']}\n作者: {data['author']} · 赞{data['liked']} 藏{data['collected']}"
              f" · {data.get('ip_location','')}")
        print(f"\n{data['desc']}\n")
        if data.get("tags"):
            print("标签: " + " ".join("#" + t for t in data["tags"]))
        for c in data.get("comments", []):
            print(f"  · {c['author']}({c['liked']}赞): {c['content'][:60]}")
            for s in c.get("replies", []):
                to = f" →{s['reply_to']}" if s.get("reply_to") else ""
                print(f"      ↳ {s['author']}{to}: {s['content'][:56]}")
            if c.get("replies_truncated"):
                print(f"      ↳ …还有 {c['reply_count'] - len(c.get('replies', []))} 条回复没展开")
    else:
        print(json.dumps(data, ensure_ascii=False, indent=1))
    for w in data.get("warnings", []) if isinstance(data, dict) else []:
        print(f"\n⚠ {w}")


KNOWN_CMDS = {"search", "note", "login", "status", "doctor", "setup"}

USAGE = """xhs-search — 小红书检索

  xhs-search "手冲咖啡"                    搜索关键词
  xhs-search <笔记链接>                    看这篇的正文
  xhs-search <笔记链接> --comments 20      正文 + 20 条评论

  搜索还能加:  --limit 30
               --sort 综合|最新|最多点赞|最多评论|最多收藏
               --type 全部|视频|图文
  任何命令加 --json 输出 JSON。

  xhs-search login     扫码登录(终端直接出二维码, 只需一次)
  xhs-search status    查登录态
  xhs-search doctor    环境自检
  xhs-search setup     装缺失依赖

给 AI 用(stdin JSON, 无需 action —— 关键词还是链接会自动判断):
  echo '{"query":"手冲咖啡","limit":10}' | xhs-search
  echo '{"query":"<笔记链接>","limit":20}' | xhs-search
"""


def main():
    global QUIET
    install_signal_handlers()
    if len(sys.argv) == 1:
        # Miyu script 工具模式: stdin 上真有数据才按 JSON 处理。只判断 isatty 不够 ——
        # 被脚本调用时 stdin 常是个一直开着却没数据的管道, 那样会永远阻塞在 read 上。
        raw = ""
        if not sys.stdin.isatty() and select.select([sys.stdin], [], [], 2.0)[0]:
            raw = sys.stdin.read().strip()  # 空的说明是 EOF(比如 </dev/null), 不是调用
        if raw:
            stdin_json_mode(raw)
            return 0
        print(USAGE)  # 人在终端里直接敲 → 给帮助, 别偷偷去开浏览器
        return 0

    # 裸参数自动分派: 像链接/note_id 的去看正文, 其余当关键词搜
    argv = sys.argv[1:]
    for i, a in enumerate(argv):
        if not a.startswith("-"):
            if a not in KNOWN_CMDS:
                argv = argv[:i] + ["note" if looks_like_note(a) else "search"] + argv[i:]
            break

    ap = argparse.ArgumentParser(prog="xhs-search", add_help=False, usage=USAGE)
    ap.add_argument("-h", "--help", action="store_true")
    sub = ap.add_subparsers(dest="cmd")

    s = sub.add_parser("search", add_help=False)
    s.add_argument("keyword")
    s.add_argument("--limit", type=int, default=20)
    s.add_argument("--sort", default="综合", choices=list(SORTS))
    s.add_argument("--type", dest="ntype", default="全部", choices=list(TYPES))

    n = sub.add_parser("note", add_help=False)
    n.add_argument("ref")
    n.add_argument("--comments", type=int, default=0)

    for name in ("login", "status", "doctor", "setup"):
        pp = sub.add_parser(name, add_help=False)
        if name == "login":
            # 默认(都不给)= 拉起后台登录、拿到二维码就返回,不等人扫。
            pp.add_argument("--check", action="store_true",
                            help="只查一次登录进度就返回")
            pp.add_argument("--blocking", action="store_true",
                            help="留在前台等到扫码完成(后台子进程自己用)")
            pp.add_argument("--timeout", type=int, default=600,
                            help="等待扫码上限(秒)")
    for pp in sub.choices.values():
        pp.add_argument("--json", action="store_true")
    ap.add_argument("--json", action="store_true")

    a = ap.parse_args(argv)
    if getattr(a, "help", False):
        print(USAGE)
        return 0
    QUIET = getattr(a, "json", False)
    cmd = a.cmd or "status"

    if cmd in ("search", "note", "login", "status"):
        ok, problems = preflight()
        if not ok:
            out = {"error": "环境不满足", "problems": problems}
            print(json.dumps(out, ensure_ascii=False, indent=1))
            return 1
    try:
        if cmd == "search":
            render(do_search(a.keyword, min(max(a.limit, 1), 100), a.sort, a.ntype), a.json, "search")
        elif cmd == "note":
            render(do_note(a.ref, min(max(a.comments, 0), 100)), a.json, "note")
        elif cmd == "login":
            if getattr(a, "blocking", False):
                render(do_login(timeout_s=a.timeout), a.json, "raw")
            elif getattr(a, "check", False):
                render(read_login_status(), a.json, "raw")
            else:
                render(start_login(timeout_s=a.timeout), a.json, "raw")
        elif cmd == "status":
            render(do_status(), a.json, "raw")
        elif cmd == "doctor":
            render(do_doctor(), True, "raw")
        elif cmd == "setup":
            render(do_setup(), True, "raw")
        return 0
    except NotLoggedIn as e:
        print(json.dumps({"error": str(e), "fix": f"运行: {login_command_hint('xhs-search')}"},
                         ensure_ascii=False, indent=1))
        return 1
    except Exception as e:
        print(json.dumps({"error": str(e)}, ensure_ascii=False, indent=1))
        return 1


if __name__ == "__main__":
    sys.exit(main())
