# CLI
# ---------------------------------------------------------------------------


def main(argv=None):
    # 放进 parent parser 并用 SUPPRESS 作默认值，这样 `--json login` 和
    # `login --json` 都能用，且子命令的默认值不会把前置的选项悄悄覆盖掉。
    common = argparse.ArgumentParser(add_help=False)
    common.add_argument("--json", dest="as_json", action="store_true",
                        default=argparse.SUPPRESS,
                        help="输出完整 JSON（默认输出精简纯文本摘要）")
    common.add_argument("-v", "--verbose", action="store_true",
                        default=argparse.SUPPRESS, help="把请求日志打到 stderr")

    parser = argparse.ArgumentParser(
        prog=prog(), parents=[common],
        description="哔哩哔哩直播控制 —— 登录 / 状态 / 分区 / 改标题分区 / 开播 / 下播",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog="""\
  %(prog)s login                      登录，调两次：先出二维码图片，用户扫完后再调一次
  %(prog)s status                     直播间状态（只读）
  %(prog)s areas                      列父分区（只读，不用登录）
  %(prog)s areas --search 虚拟         在子分区里搜关键词
  %(prog)s areas --parent 网游         列某个父分区下的子分区
  %(prog)s update --title "新标题"     改直播标题
  %(prog)s update --area 虚拟日常      改分区（名字、拼音或 id 都行）
  %(prog)s start --title X --area Y   开播，顺手改标题和分区（直播间会对外可见）
  %(prog)s stop                       下播
  %(prog)s logout                     登出

默认输出精简纯文本摘要；要完整结构化数据加 --json。
""")
    subparsers = parser.add_subparsers(dest="command")

    login = subparsers.add_parser("login", parents=[common], help="登录（扫码，两步）")
    login.add_argument("--cookie", metavar="COOKIE",
                       help='改用 Cookie 直接登录："SESSDATA=..; bili_jct=.."')
    login.add_argument("--wait", type=int, default=0,
                       help="阻塞等待用户扫码的秒数（默认 0，即不等待、立刻返回）")
    subparsers.add_parser("logout", parents=[common], help="登出，删除本地凭据")
    subparsers.add_parser("status", parents=[common], help="直播间状态（只读）")

    areas = subparsers.add_parser("areas", parents=[common],
                                  help="查分区（只读，不需要登录）")
    areas.add_argument("--search", metavar="关键词",
                       help="在子分区的名字、拼音和父分区名里搜")
    areas.add_argument("--parent", metavar="父分区",
                       help="只列这个父分区（名字或 id）下的子分区")
    areas.add_argument("--refresh", action="store_true",
                       help="忽略本地缓存，重新拉一次分区列表")

    update = subparsers.add_parser("update", parents=[common],
                                   help="改直播标题 / 分区（在播时立刻对观众生效）")
    update.add_argument("--title", help="新的直播标题")
    update.add_argument("--area", metavar="分区",
                        help='新的分区：id、名字、拼音或"父分区/子分区"')

    start = subparsers.add_parser("start", parents=[common],
                                  help="开播并返回推流地址与推流码（★ 直播间立刻对外可见）")
    start.add_argument("--title", help="开播前把直播标题改成这个")
    start.add_argument("--area", metavar="分区", help="开播前把分区改成这个")
    subparsers.add_parser("stop", parents=[common], help="下播")
    update.epilog = "标题和分区一起给是一次请求；分开连着调会被 B 站限流。"

    args = parser.parse_args(argv)
    for name, default in (("as_json", False), ("verbose", False)):
        if not hasattr(args, name):
            setattr(args, name, default)
    if not args.command:
        parser.print_help()
        return 2

    sess = Session(args.verbose)
    try:
        if args.command == "login":
            data = op_login(sess, args.cookie, args.wait)
        elif args.command == "logout":
            data = op_logout(sess)
        elif args.command == "status":
            data = op_status(sess)
        elif args.command == "areas":
            data = op_areas(sess, args.search, args.parent, args.refresh)
        elif args.command == "update":
            data = op_update(sess, args.title, args.area)
        elif args.command == "start":
            data = op_start(sess, args.title, args.area)
        else:
            data = op_stop(sess)
    except ToolError as exc:
        emit_error(args.command, exc, args.as_json)
        return 1
    except KeyboardInterrupt:
        print("已中断", file=sys.stderr)
        return 130
    finally:
        sess.flush()

    emit(args.command, data, args.as_json)
    return 0


def _argv_from_stdin():
    """Miyu 的脚本工具把参数以 JSON 从 stdin 传入、argv 为空，这里转成 CLI 参数。"""
    if sys.argv[1:] or sys.stdin.isatty():
        return None
    try:
        raw = sys.stdin.read().strip()
    except Exception:
        return None
    if not raw:
        return None
    try:
        payload = json.loads(raw)
    except Exception:
        return None
    if not isinstance(payload, dict):
        return None
    argv = []
    cmd = payload.pop("command", None)
    if cmd:
        argv.append(str(cmd))
    for key, value in payload.items():
        if value is None or value is False or value == "":
            continue
        flag = "--" + str(key).replace("_", "-")
        if value is True:
            argv.append(flag)
        else:
            argv.extend([flag, str(value)])
    return argv


if __name__ == "__main__":
    sys.exit(main(_argv_from_stdin()))
