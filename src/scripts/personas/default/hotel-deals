def build_parser():
    ap = argparse.ArgumentParser(
        prog="hotel-deals",
        description="查某地最便宜的酒店，跨平台比价，看价格趋势。",
        formatter_class=argparse.RawDescriptionHelpFormatter, epilog=EPILOG)
    sub = ap.add_subparsers(dest="cmd", metavar="<动作>")

    def core(sp, title="核心参数"):
        return sp.add_argument_group(title)

    def extras(sp):
        """次要开关。单开一组，免得把核心的三个参数淹掉。"""
        return sp.add_argument_group("可选")

    def who(g):
        g.add_argument("--adults", type=int, default=2, metavar="<人数>",
                       help="入住人数（默认 2）")

    def money_opts(g):
        g.add_argument("--currency", default="CNY", metavar="<币种>",
                       help="币种（默认 CNY）")
        g.add_argument("--region", default="jp", metavar="<地区码>",
                       help="Google 地区码（默认 jp；韩国 kr、泰国 th）")

    def output(g):
        # 定在子命令上而不是顶层：这样 `-l 东京 --json` 这种自然写法能用，
        # argparse 的顶层选项必须写在子命令前面，太反直觉。
        g.add_argument("--format", choices=("auto", "table", "md", "json"),
                       default="auto", metavar="<格式>",
                       help="table/md/json；默认 auto=终端出表格、管道出 markdown")
        g.add_argument("--json", dest="as_json", action="store_true",
                       help="等同 --format json")

    # ---- search：地点 + 入住 + 退房，就这三个
    s = sub.add_parser(
        "search", help="查指定日期的最低价（默认动作）",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        description="查指定日期的最低价，并列出同店的跨平台价差。\n"
                    "通常只要 --location / --checkin / --checkout 三个参数。")
    g = core(s, "核心参数（通常只用这三个）")
    g.add_argument("-l", "--location", required=True, metavar="<位置>",
                   help="地区名，如 东京 / Tokyo / Shibuya Tokyo")
    g.add_argument("-c", "--checkin", type=parse_day, metavar="<日期>",
                   help="入住日（默认 7 天后）")
    g.add_argument("-o", "--checkout", type=parse_day, metavar="<日期>",
                   help="退房日（默认入住次日）")
    g = extras(s)
    g.add_argument("-n", "--nights", type=int, default=1, metavar="<晚数>",
                   help="住几晚。只在不给 --checkout 时用来算退房日（默认 1）")
    # 两种写法都收：`-s google -s booking` 和 `--sources google booking`。
    g.add_argument("-s", "--source", "--sources", action="extend", nargs="+",
                   choices=("google", "booking"), metavar="<平台>",
                   help="数据源，可重复或一次给多个（默认两个都用）")
    g.add_argument("--rooms", type=int, default=1, metavar="<间数>",
                   help="几间房（默认 1）")
    who(g)
    money_opts(g)
    g.add_argument("--top", type=int, default=20, metavar="<条数>",
                   help="显示几条（默认 20）")
    g.add_argument("--limit", type=int, default=40, metavar="<条数>",
                   help="每个源最多取几条（默认 40）")
    g.add_argument("--no-headless", action="store_true", help="Booking 用有头浏览器")
    g.add_argument("--no-record", action="store_true", help="不写价格历史")
    output(g)
    s.set_defaults(func=cmd_search)

    # ---- sweep：不知道哪天去，扫一段
    w = sub.add_parser(
        "sweep", help="扫未来 N 天，看哪天入住最便宜",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        description="扫连续 N 个入住日，找出最便宜的那天。走 Google 源。")
    g = core(w)
    g.add_argument("-l", "--location", required=True, metavar="<位置>", help="地区名")
    g.add_argument("-c", "--checkin", type=parse_day, metavar="<日期>",
                   help="从哪天开始扫（默认明天）")
    g.add_argument("-d", "--days", type=int, default=30, metavar="<天数>",
                   help="扫多少天（默认 30）")
    g = extras(w)
    g.add_argument("-n", "--nights", type=int, default=1, metavar="<晚数>",
                   help="每个日期各住几晚（默认 1）")
    # 只允许 google：Booking 要开浏览器，扫几十天既慢又必被限流。明写出来是为了让
    # `sweep -s booking` 报「只能选 google」，而不是含糊的 unrecognized arguments。
    g.add_argument("-s", "--source", "--sources", action="extend", nargs="+",
                   choices=("google",), metavar="<平台>",
                   help="数据源，只支持 google（Booking 要开浏览器，扫多天必被限流）")
    who(g)
    money_opts(g)
    g.add_argument("--workers", type=int, default=6, metavar="<并发>",
                   help="并发请求数（默认 6）")
    g.add_argument("--no-record", action="store_true", help="不写价格历史")
    output(g)
    w.set_defaults(func=cmd_sweep)

    # ---- trend：看攒下来的历史
    t = sub.add_parser(
        "trend", help="看历史库里攒下来的底价涨跌",
        description="看同一地区的底价随观测时间怎么变。需要先攒几天数据。")
    g = core(t)
    g.add_argument("-l", "--location", required=True, metavar="<位置>", help="地区名")
    g = extras(t)
    g.add_argument("-c", "--checkin", type=parse_day, metavar="<日期>",
                   help="只看某个入住日的历史")
    g.add_argument("-s", "--source", "--sources", action="extend", nargs="+",
                   choices=("google", "booking"), metavar="<平台>",
                   help="只看某个平台")
    g.add_argument("--currency", default="CNY", metavar="<币种>", help="币种（默认 CNY）")
    output(g)
    t.set_defaults(func=cmd_trend)

    pl = sub.add_parser("places", help="历史库里有哪些地区",
                        description="列出历史库里攒过数据的地区。不接受 --location。")
    output(pl.add_argument_group("可选"))
    pl.set_defaults(func=cmd_places)

    d = sub.add_parser("doctor", help="环境自检",
                       description="检查 Google 源能不能抓、Booking 的 playwright 装没装。")
    d.set_defaults(func=cmd_doctor, format="table", as_json=False)
    return ap


def option_strings(ap, values_only=False):
    """把 parser 里的选项名全捞出来。

    从 parser 自己身上问，比在别处手抄一份选项表可靠 —— 加了新选项不会忘同步。
    values_only=True 时只要「后面得跟一个值」的那些，用来在 normalize_argv 里
    分辨某个词是动作还是选项的值（`--location search`）。
    """
    flags, stack = set(), [ap]
    while stack:
        cur = stack.pop()
        for act in cur._actions:
            if isinstance(act, argparse._SubParsersAction):
                stack.extend(act.choices.values())
            elif act.option_strings and not (values_only and act.nargs == 0):
                flags.update(act.option_strings)
    return flags


def value_flags(ap):
    return option_strings(ap, values_only=True)


def normalize_argv(argv, ap):
    """把动作词挪到最前面，没写动作就补 search。

    argparse 要求子命令必须是第一个词，但既然对外说了「参数位置无关」，
    动作也该随便放。省略时默认 search，让最常用的操作能写成
    `hotel-deals -l 东京`。
    """
    if not argv or argv[0] in ACTIONS or argv[0] in ("-h", "--help"):
        return argv

    vflags = value_flags(ap)
    skip_next, action, rest = False, None, []
    for tok in argv:
        if skip_next:                       # 这个词是上一个选项的值，别当动作
            skip_next = False
        elif tok in vflags:
            skip_next = True
        elif action is None and tok in ACTIONS:
            action = tok
            continue
        rest.append(tok)
    return [action or "search"] + rest


# ---------------------------------------------------------------- 程序调用入口

def json_keys(ap):
    """从 parser 反推 {参数名: (flag, 是不是开关)}。

    跟 option_strings() 一个道理：现问 parser 要，而不是在别处手抄一份，
    这样加了新选项、改了名字，JSON 入口不会悄悄跟 CLI 走散。
    """
    keys, stack = {}, [ap]
    while stack:
        cur = stack.pop()
        for act in cur._actions:
            if isinstance(act, argparse._SubParsersAction):
                stack.extend(act.choices.values())
                continue
            for flag in act.option_strings:
                if flag.startswith("--") and flag != "--help":
                    keys.setdefault(flag[2:].replace("-", "_"), (flag, act.nargs == 0))
            if act.dest and act.dest not in ("help", argparse.SUPPRESS):
                for flag in act.option_strings:
                    if flag.startswith("--"):
                        keys.setdefault(act.dest, (flag, act.nargs == 0))
                        break
    return keys


def argv_from_json(payload, ap):
    """把 {"location": "东京", "sources": ["google"]} 摊成一行 argv。

    工具层（Miyu 之类）调脚本时是把参数打成 JSON 从 stdin 喂进来的，argv 是空的。
    没有这个入口，脚本会当成「没给动作」直接打印帮助然后退出 —— 更糟的是退出码 0，
    调用方拿到一坨帮助文本还以为查询成功了。
    """
    if not isinstance(payload, dict):
        raise Failed("stdin 里的 JSON 得是一个对象",
                     '例如 {"location": "东京", "checkin": "2026-10-15"}')

    known = json_keys(ap)
    action = payload.get("action") or payload.get("cmd") or "search"
    if action not in ACTIONS:
        raise Failed(f"未知动作 {action!r}", f"可选：{'、'.join(ACTIONS)}")

    argv, unknown = [action], []
    for key, val in payload.items():
        if key in ("action", "cmd") or val is None:
            continue
        hit = known.get(key) or known.get(str(key).replace("-", "_"))
        if hit is None:
            unknown.append(key)
            continue
        flag, is_switch = hit
        if is_switch:                       # store_true：给了真值才带上这个 flag
            if val:
                argv.append(flag)
            continue
        vals = val if isinstance(val, (list, tuple)) else [val]
        argv.append(flag)
        argv.extend(str(v) for v in vals)

    if unknown:
        # 静默忽略拼错的参数最坑：调用方以为限定生效了，其实拿的是默认值的结果。
        guess = ", ".join(sorted(known)[:12])
        raise Failed(f"不认识这些参数：{', '.join(map(repr, unknown))}",
                     f"可用参数有 {guess} 等；完整列表跑 doctor 或看 --help")
    return argv


def read_json_stdin():
    """stdin 上有 JSON 就取回来，没有则返回 None（照常走 CLI）。"""
    if sys.stdin is None or sys.stdin.isatty():
        return None
    raw = sys.stdin.read().strip()
    if not raw:
        return None
    try:
        return json.loads(raw)
    except json.JSONDecodeError as exc:
        raise Failed(f"stdin 不是合法 JSON：{exc}",
                     '喂一个对象进来，例如 {"location": "东京"}')


def main():
    migrate_legacy_data()  # 必须在任何读写历史库之前
    ap = build_parser()
    argv = sys.argv[1:]
    try:
        if not argv:
            payload = read_json_stdin()
            if payload is not None:
                argv = argv_from_json(payload, ap)
    except Failed as exc:
        print(f"失败：{exc}", file=sys.stderr)
        if exc.hint:
            print(f"下一步：{exc.hint}", file=sys.stderr)
        return 1

    argv = normalize_argv(argv, ap)
    if not argv:
        ap.print_help()
        return 2

    a = ap.parse_args(argv)
    if a.as_json:
        a.format = "json"
    if a.format == "auto":
        a.format = "table" if sys.stdout.isatty() else "md"

    try:
        return a.func(a)
    except Failed as exc:
        print(f"失败：{exc}", file=sys.stderr)
        if exc.hint:
            print(f"下一步：{exc.hint}", file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        print("\n中断", file=sys.stderr)
        return 130


if __name__ == "__main__":
    sys.exit(main())
