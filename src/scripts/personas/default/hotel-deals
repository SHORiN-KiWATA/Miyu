    print(f"最新 {rows[-1][0][:16]}  {money(last, a.currency)}/晚  {arrow} {delta:+.1f}%")
    print(f"区间 {money(min(vals), a.currency)} ~ {money(max(vals), a.currency)}"
          f" · {len(rows)} 个观测点")
    return 0


