    if len(rows) < 2:
        print(f"{a.location} 目前只有 {len(rows)} 个观测点，还画不出趋势。")
        print("趋势要靠每天跑一次攒出来，比如挂个 cron：")
        print(f"  0 9 * * * cd {os.getcwd()} && "
              f"./hotel-deals -l {a.location} >/dev/null 2>&1")
