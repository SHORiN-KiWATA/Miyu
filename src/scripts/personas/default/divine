# The Rust tool draws from the OS-seeded thread_rng; secrets is the closest
# stdlib equivalent (uniform choice/range from the OS entropy pool).
_rng = secrets.SystemRandom()


def fail(error, fix=None, code=2):
    print(json.dumps({"ok": False, "error": error, "fix": fix}, ensure_ascii=False))
    sys.exit(code)


def as_u64(value):
    """serde_json Value::as_u64: only non-negative integers count; floats,
    bools, strings and negatives fall through to the default."""
    if isinstance(value, bool) or not isinstance(value, int) or value < 0:
        return None
    return value


def as_i64(value):
    if isinstance(value, bool) or not isinstance(value, int):
        return None
    return value


def clamp(value, low, high):
    return max(low, min(high, value))


def roll_dice(args):
    count = as_u64(args.get("count"))
    sides = as_u64(args.get("sides"))
    modifier = as_i64(args.get("modifier"))
    count = clamp(1 if count is None else count, 1, 100)
    sides = clamp(6 if sides is None else sides, 2, 1000)
    modifier = 0 if modifier is None else modifier
    rolls = [_rng.randint(1, sides) for _ in range(count)]
    total = sum(rolls)
    # serde_json without preserve_order emits keys sorted; mirror that.
    return json.dumps(
        {
            "ok": True,
            "count": count,
            "sides": sides,
            "rolls": rolls,
            "total": total,
            "modifier": modifier,
            "modified_total": total + modifier,
        },
        ensure_ascii=False,
        separators=(",", ":"),
        sort_keys=True,
    )


def divine(args):
    method = args.get("method")
    method = method if isinstance(method, str) else ""
    if method == "zhouyi":
        return _rng.choice(ZHOUYI_HEXAGRAMS)
    if method == "tarot":
        return f"{_rng.choice(TAROT_CARDS)}（{_rng.choice(TAROT_ORIENTATIONS)}）"
    if method == "fortune":
        luck, meaning = _rng.choice(FORTUNE_DIVINATIONS)
        return f"{luck}：{meaning}"
    if method == "dice":
        return roll_dice(args)
    fail(
        f"unknown method: {method}; expected zhouyi, tarot, fortune or dice",
        "pass method as one of zhouyi, tarot, fortune, dice",
    )


def read_args():
    raw = os.environ.get("MIYU_ARGS_JSON")
    if not raw:
        raw = "" if sys.stdin is None or sys.stdin.isatty() else sys.stdin.read()
    raw = (raw or "").strip() or "{}"
    try:
        args = json.loads(raw)
    except json.JSONDecodeError as exc:
        fail(f"arguments are not valid JSON: {exc}", 'feed one object, e.g. {"method":"tarot"}')
    if not isinstance(args, dict):
        fail("arguments must be a JSON object", 'e.g. {"method":"zhouyi"}')
    return args


def main():
    args = read_args()
    if len(sys.argv) > 1 and "method" not in args:
        # Convenience for running by hand: `divine tarot` / `divine dice 3 20`.
        args["method"] = sys.argv[1]
        if len(sys.argv) > 2 and sys.argv[2].isdigit():
            args["count"] = int(sys.argv[2])
        if len(sys.argv) > 3 and sys.argv[3].isdigit():
            args["sides"] = int(sys.argv[3])
    print(divine(args))


if __name__ == "__main__":
    main()
