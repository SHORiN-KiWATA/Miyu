def run(args):
    request = parse_request(args)
    if not request["location"]:
        raise Failed(
            "location is required. Ask the user which city or place to query, then call get_weather again with that location.",
            "问用户要查哪个城市或地点，再带 location 重新调用",
        )
    qt = request["query_type"]
    if qt == "forecast":
        try:
            return get_forecast(request)
        except Failed as open_meteo_error:
            try:
                return get_weather_wttr(request["location"], "open_meteo_fallback")
            except Failed as wttr_error:
                raise Failed(
                    f"weather query failed; open_meteo: {open_meteo_error}; wttr.in: {wttr_error}",
                    open_meteo_error.fix or wttr_error.fix or "检查地名拼写或稍后再试",
                ) from wttr_error
    return {
        "air_quality": get_air_quality,
        "historical": get_historical,
        "marine": get_marine,
        "climate": get_climate,
        "elevation": get_elevation,
    }[qt](request)


def fail(error, fix=None, code=1):
    print(json.dumps({"ok": False, "error": error, "fix": fix}, ensure_ascii=False))
    sys.exit(code)


def main():
    raw = os.environ.get("MIYU_ARGS_JSON") or sys.stdin.read() or "{}"
    try:
        args = json.loads(raw)
    except json.JSONDecodeError as exc:
        fail(f"arguments are not valid JSON: {exc}", "从 stdin 传一个 JSON 对象，如 {\"location\":\"Tokyo\"}", 2)
    if not isinstance(args, dict):
        fail("arguments must be a JSON object", "如 {\"location\":\"Tokyo\"}", 2)
    try:
        print(run(args))
    except Failed as exc:
        fail(str(exc), exc.fix or None)
    except Exception as exc:  # noqa: BLE001 —— 工具层不该看到 traceback
        fail(f"internal error: {type(exc).__name__}: {exc}", "稍后再试；若持续出现请反馈")


if __name__ == "__main__":
    main()
