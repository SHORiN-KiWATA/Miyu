def date_range(request, kind):
    start = request["start_date"]
    if not start:
        raise Failed(f"{kind} query requires start_date", "传 start_date（YYYY-MM-DD）")
    return start, request["end_date"] or start


def get_historical(request):
    start, end = date_range(request, "historical")
    locations, loc = selected_location(request)
    response = http_get(ARCHIVE_URL, [
        ("latitude", str(loc["latitude"])), ("longitude", str(loc["longitude"])),
        ("start_date", start), ("end_date", end),
        ("daily", "weather_code,temperature_2m_max,temperature_2m_min,precipitation_sum,wind_speed_10m_max"),
        ("timezone", "auto"), ("temperature_unit", "celsius"), ("wind_speed_unit", "kmh"), ("precipitation_unit", "mm"),
    ])
    daily = require(response, "daily")
    dates = require(daily, "time")
    first_date = dates[0] if dates else start
    summary = (
        f"{format_location(loc)}：历史天气 {start} 至 {end}，首日({first_date})"
        f"{label_or(value_at(daily.get('weather_code'), 0), weather_code_label, '未知天气')}，"
        f"{fmt_temperature(value_at(daily.get('temperature_2m_min'), 0))}-{fmt_temperature(value_at(daily.get('temperature_2m_max'), 0))}，"
        f"降水{fmt_precipitation(value_at(daily.get('precipitation_sum'), 0))}，"
        f"最大风速{fmt_speed(value_at(daily.get('wind_speed_10m_max'), 0))}。"
    )
    rows = []
    for i, date in enumerate(dates):
        code = value_at(daily.get("weather_code"), i)
        rows.append({
            "date": date,
            "condition": maybe(code, weather_code_label),
            "weather_code": code,
            "temperature_min_c": value_at(daily.get("temperature_2m_min"), i),
            "temperature_max_c": value_at(daily.get("temperature_2m_max"), i),
            "precipitation_sum_mm": value_at(daily.get("precipitation_sum"), i),
            "wind_speed_max_kmh": value_at(daily.get("wind_speed_10m_max"), i),
        })
    return dump({
        "provider": "open_meteo",
        "query_type": "historical",
        "resolved_location": location_json(loc),
        "alternatives": alternatives_json(locations),
        "start_date": start,
        "end_date": end,
        "summary": summary,
        "daily": rows,
        "source": open_meteo_source("历史天气基于再分析数据，不等同于站点实测。"),
    })


