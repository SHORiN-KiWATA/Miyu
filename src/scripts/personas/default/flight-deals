FLIGHTS_URL = "https://www.google.com/travel/flights"
# 结果页视图描述符。跟查询内容无关，是个常量，照抄浏览器发的那个就行。
TFU = "EgQIABABIgA"


def flights_url(origin, dest, depart, ret, seat, adults, children, currency,
                max_stops, region="us"):
    trip = TRIP_ONEWAY if ret is None else TRIP_ROUND
    legs = [(depart, origin.codes, dest.codes)]
    if ret is not None:
        legs.append((ret, dest.codes, origin.codes))
    tfs = build_tfs(legs, seat, adults, children, trip, max_stops)
    return FLIGHTS_URL + "?" + urllib.parse.urlencode({
        "tfs": tfs,
        # 固定英文站：卡片的 aria-label 只有英文站是这套句式，换 hl 会整套解析失效。
        "hl": "en", "gl": region, "curr": currency, "tfu": TFU})


def google_search(origin, dest, depart, ret=None, seat=1, adults=1, children=0,
                  currency="CNY", max_stops=None, limit=60, region="us", timeout=40):
    """纯 HTTP 抓 Google 航班。行程信息都在卡片的 aria-label 上，首屏 HTML 就有。"""
    url = flights_url(origin, dest, depart, ret, seat, adults, children,
                      currency, max_stops, region)
    req = urllib.request.Request(url, headers={
        "User-Agent": UA, "Accept-Language": "en-US,en;q=0.9"})
    try:
        with urllib.request.urlopen(req, timeout=timeout) as r:
            page = r.read().decode("utf-8", "replace")
    except Exception as exc:
        raise Failed(f"Google 请求失败：{exc}", "检查网络后重试")

    has_results = bool(_RESULTS_MARK.search(page))
    itins = []
    for raw in _CARD.findall(page):
        it = parse_card(_html.unescape(raw), currency, depart, url)
        if it is not None:
            itins.append(it)

    itins = dedupe(itins)

    if not itins:
        # 三种「零结果」必须分清楚，否则调用方会把「参数没生效」当成「没航班」。
        if not has_results:
            bad = [p.query for p in (origin, dest) if p.passthrough]
            raise Failed(
                f"Google 没认出这条航线（{origin.label} → {dest.label}）",
                (f"机场码 {'、'.join(bad)} 可能不存在，核对一下；" if bad else "")
                + "或跑 flight-deals airports <地名> 查正确的三字码")
        return []                      # 页面正常但真的一班都没有
    if not has_results:
        raise Failed("页面结构变了：解析出了价格，却找不到结果列表标记",
                     "多半是 Google 改版，需要更新脚本里的 _RESULTS_MARK/_L_* 正则")

    itins.sort(key=lambda i: i.price)
    return itins[:limit]


