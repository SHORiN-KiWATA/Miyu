"""


def db():
    os.makedirs(os.path.dirname(DB_PATH), exist_ok=True)
    conn = sqlite3.connect(DB_PATH)
    conn.row_factory = sqlite3.Row
    conn.executescript(SCHEMA)
    return conn


def record(origin, dest, itins, seat, adults):
    now = datetime.now(timezone.utc).isoformat(timespec="seconds")
    key = route_key(origin, dest)
    rows = []
    for it in itins:
        if it.price is None or it.dep_at is None:
            continue
        rows.append((now, key, origin.label, dest.label,
                     it.dep_at.date().isoformat(),
                     None if it.round_trip is False else None,
                     0 if it.round_trip else 1, seat, adults, it.currency,
                     it.price, it.stops, ",".join(it.airlines), it.duration_min))
    with db() as conn:
        conn.executemany(
            "INSERT INTO observations (observed_at, route, origin, dest, depart,"
            " ret, one_way, seat, adults, currency, price, stops, airlines,"
            " duration_min) VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?)", rows)
    return len(rows)


def floor_history(route, depart=None):
    sql = ("SELECT observed_at, MIN(price) AS floor, currency FROM observations"
           " WHERE route = ?")
    args = [route]
    if depart:
        sql += " AND depart = ?"
        args.append(depart.isoformat())
    sql += " GROUP BY substr(observed_at, 1, 13) ORDER BY observed_at"
    with db() as conn:
        return [(r["observed_at"], r["floor"], r["currency"])
                for r in conn.execute(sql, args)]


def known_routes():
    with db() as conn:
        return list(conn.execute(
            "SELECT route, origin, dest, COUNT(*) n, MAX(observed_at) last"
            " FROM observations GROUP BY route ORDER BY last DESC"))


# ---------------------------------------------------------------- 扫日期窗口

def plan_trips(window, day_specs, one_way):
    """列出窗口里所有值得一查的行程。

    刻意不做「出发日 × 返程日」的笛卡尔积 —— 那里面绝大多数组合(当天往返、
    玩二十天)没人会考虑，白白多花几十次请求。真实请求是「国庆这几天里去玩
    五到七天」，所以按「窗口内滑动一段固定时长」来枚举，组合数从平方降到线性。

    返程日必须落在窗口内：窗口就是「这段时间我能出门」的意思。
    """
    start, end = window
    trips = []
    day = start
    while day <= end:
        if one_way:
            trips.append((day, None))
        else:
            for n in day_specs:
                back = day + timedelta(days=n)
                if back <= end:
                    trips.append((day, back))
        day += timedelta(days=1)
    return trips


def sweep(origin, dest, trips, seat, adults, children, currency, max_stops,
          workers=6, progress=None):
    """并发扫一批行程，每个只取当天最低价。实测 16 个组合 6 并发 ~4.5 秒，无限流。"""

    def one(trip):
        depart, ret = trip
        try:
            itins = google_search(origin, dest, depart, ret, seat, adults,
                                  children, currency, max_stops, limit=60)
        except Failed as exc:               # 单个组合失败不该拖垮整张表
            return {"depart": depart, "ret": ret, "floor": None,
                    "error": str(exc)[:70]}
        if not itins:
            return {"depart": depart, "ret": ret, "floor": None, "error": "无航班"}
        best = itins[0]
        prices = [i.price for i in itins]
        direct = [i for i in itins if i.stops == 0]
        return {"depart": depart, "ret": ret, "floor": best.price,
                "median": statistics.median(prices), "count": len(itins),
                "direct_floor": direct[0].price if direct else None,
                "airlines": "/".join(best.airlines[:2]),
                "stops": best.stops, "duration_min": best.duration_min,
                "error": None}

    out, done = {}, 0
    with ThreadPoolExecutor(max_workers=workers) as pool:
        for res in pool.map(one, trips):
            out[(res["depart"], res["ret"])] = res
            done += 1
            if progress:
                progress(done, len(trips))
    return [out[t] for t in trips]


# ---------------------------------------------------------------- 输出

def wcwidth(s):
    """CJK 字符占两格，不算宽度表格会错位。"""
    return sum(2 if unicodedata.east_asian_width(c) in "WF" else 1 for c in str(s))


def pad(s, width, align="<"):
    s = str(s)
    gap = width - wcwidth(s)
    if gap < 0:
        out = ""
        for c in s:
            if wcwidth(out + c) > width - 1:
                break
            out += c
        return out + "…" + " " * (width - wcwidth(out) - 1)
    return (" " * gap + s) if align == ">" else (s + " " * gap)


def table(headers, rows, aligns=None, md=False):
    """对齐的纯文本表格；md=True 出 Markdown。"""
    if not rows:
        return ""
    aligns = aligns or ["<"] * len(headers)
    widths = [max(wcwidth(h), max(wcwidth(r[i]) for r in rows))
              for i, h in enumerate(headers)]
    if md:
        sep = ["---:" if a == ">" else "---" for a in aligns]
        lines = ["| " + " | ".join(headers) + " |", "| " + " | ".join(sep) + " |"]
        lines += ["| " + " | ".join(str(c) for c in r) + " |" for r in rows]
        return "\n".join(lines)
    out = ["  ".join(pad(h, widths[i], aligns[i]) for i, h in enumerate(headers)).rstrip(),
           "  ".join("─" * widths[i] for i in range(len(headers)))]
    out += ["  ".join(pad(c, widths[i], aligns[i])
                      for i, c in enumerate(r)).rstrip() for r in rows]
    return "\n".join(out)


def money(v, currency):
    return "—" if v is None else f"{SYMBOL.get(currency, currency + ' ')}{v:,.0f}"


def week_cn(d):
    return "一二三四五六日"[d.weekday()]


def sparkline(values):
    real = [v for v in values if v is not None]
    if not real:
        return ""
    lo, hi = min(real), max(real)
    span = hi - lo
    return "".join(
        " " if v is None else
        SPARK[len(SPARK) // 2] if span == 0 else
        SPARK[int((v - lo) / span * (len(SPARK) - 1))]
        for v in values)


def price_note(one_way, adults, children, seat):
    who = f"{adults} 成人" + (f" + {children} 儿童" if children else "")
    kind = "单程" if one_way else "往返总价"
    return f"价格为{kind}起价（{who}，{SEAT_CN[seat]}），实际下单价可能更高"


def render_search(itins, origin, dest, depart, ret, seat, adults, children,
                  currency, top, fmt, url, warnings=()):
    """出报表。

    warnings 一定要进 stdout：程序调用时通常只收 stdout，写进 stderr 的提醒
    等于没写 —— 「机场码是猜的」和「机场码是查表来的」输出会长得一模一样。
    """
    one_way = ret is None
    if fmt == "json":
        return json.dumps({
            "query": {"origin": origin.as_dict(), "destination": dest.as_dict(),
                      "depart": depart.isoformat(),
                      "return": ret.isoformat() if ret else None,
                      "one_way": one_way, "seat": SEATS_INV[seat],
                      "adults": adults, "children": children,
                      "currency": currency},
            "price_means": "round_trip_total" if not one_way else "one_way_total",
            "warnings": list(warnings),
            "returned": min(top, len(itins)), "total": len(itins),
            "url": url,
            "itineraries": [i.as_dict() for i in itins[:top]],
        }, ensure_ascii=False, indent=2)

    md = fmt == "md"
    span = f"{depart} 走" + (f" · {ret} 回（{(ret - depart).days} 天）" if ret else " · 单程")
    head = f"{origin.label} → {dest.label}   {span}"

    rows = []
    for i, it in enumerate(itins[:top], 1):
        stop_txt = "直飞" if it.stops == 0 else (f"{it.stops} 转" if it.stops else "—")
        if it.layovers:
            stop_txt += " " + "/".join(
                f"{ap}{fmt_dur(d)}" + ("(换机场)" if x else "")
                for d, ap, x in it.layovers[:2])
        dep = it.dep_at.strftime("%m-%d %H:%M") if it.dep_at else "—"
        if it.variants > 1:
            dep += f" +{it.variants - 1}"
        rows.append([str(i), money(it.price, currency),
                     "/".join(it.airlines[:2]) or "—", dep,
                     it.arr_at.strftime("%m-%d %H:%M") if it.arr_at else "—",
                     fmt_dur(it.duration_min), stop_txt])
    body = table(["#", "价格", "航司", "起飞", "到达", "时长", "中转"],
                 rows, [">", ">", "<", "<", "<", ">", "<"], md)

    parts = [f"# {head}" if md else head, "", body]
    if itins:
        cheapest = itins[0]
        fastest = min((i for i in itins if i.duration_min), default=None,
                      key=lambda i: i.duration_min)
        direct = [i for i in itins if i.stops == 0]
        summary = [f"最低 {money(cheapest.price, currency)}"
                   f"（{'/'.join(cheapest.airlines[:2]) or '?'}，{fmt_dur(cheapest.duration_min)}）"]
        if direct:
            summary.append(f"直飞最低 {money(direct[0].price, currency)}")
        if fastest and fastest is not cheapest:
            summary.append(f"最快 {fmt_dur(fastest.duration_min)}"
                           f" {money(fastest.price, currency)}")
        parts += ["", " · ".join(summary)]

    notes = [price_note(one_way, adults, children, seat)]
    if any(i.variants > 1 for i in itins[:top]):
        notes.append("起飞时刻后的 +N 表示同价同航司还有 N 个别的起飞时刻，"
                     "表里只留了最快的那班（要全部时刻加 --no-fold）")
    notes += warnings
    parts += ["", "## 注意" if md else "注意", ""] + [f"- {n}" for n in notes]
    if url:
        parts += ["", f"在 Google 航班里打开：{url}"]
    return "\n".join(parts)


def render_sweep(series, origin, dest, window, one_way, seat, adults, children,
                 currency, fmt, warnings=()):
    if fmt == "json":
        days = [{**d, "depart": d["depart"].isoformat(),
                 "ret": d["ret"].isoformat() if d["ret"] else None} for d in series]
        return json.dumps({
            "query": {"origin": origin.as_dict(), "destination": dest.as_dict(),
                      "window": [window[0].isoformat(), window[1].isoformat()],
                      "one_way": one_way, "seat": SEATS_INV[seat],
                      "adults": adults, "children": children, "currency": currency},
            "price_means": "round_trip_total" if not one_way else "one_way_total",
            "warnings": list(warnings),
            "scanned": sum(1 for d in series if d["floor"] is not None),
            "total": len(series),
            "trips": days,
        }, ensure_ascii=False, indent=2)

    md = fmt == "md"
    valid = [d for d in series if d["floor"] is not None]
    lo = min((d["floor"] for d in valid), default=None)

    rows = []
    for d in series:
        when = f"{d['depart']:%m-%d}(周{week_cn(d['depart'])})"
        back = f"{d['ret']:%m-%d}(周{week_cn(d['ret'])})" if d["ret"] else "单程"
        days = str((d["ret"] - d["depart"]).days) if d["ret"] else "—"
        if d["floor"] is None:
            rows.append([when, back, days, "—", "—", "—", d.get("error", "")])
            continue
        rows.append([when, back, days, money(d["floor"], currency),
                     money(d.get("direct_floor"), currency), str(d.get("count", "")),
                     (d.get("airlines") or "") + (" ◀" if d["floor"] == lo else "")])
    body = table(["出发", "返程", "天数", "最低价", "直飞最低", "航班", "最便宜的航司"],
                 rows, ["<", "<", ">", ">", ">", ">", "<"], md)

    title = (f"{origin.label} → {dest.label}   "
             f"{window[0]} ~ {window[1]} 窗口内 {len(series)} 个行程")
    parts = [f"# {title}" if md else title, "", body]

    if not valid:
        return "\n".join(parts + ["", "一个有效报价都没扫到。",
                                  "先用 search 查单个日期确认这条航线本身能查通。"])

    best = min(valid, key=lambda d: d["floor"])
    worst = max(valid, key=lambda d: d["floor"])
    floors = [d["floor"] for d in valid]
    spread = (worst["floor"] - best["floor"]) / best["floor"] * 100 if best["floor"] else 0
    missing = len(series) - len(valid)
    b_back = f" · {best['ret']} 回" if best["ret"] else " · 单程"
    parts += [
        "", f"走势  {sparkline([d['floor'] for d in series])}",
        f"最便宜  {best['depart']}（周{week_cn(best['depart'])}）走{b_back}  "
        f"{money(best['floor'], currency)}"
        + (f" · {best['airlines']}" if best.get("airlines") else "")
        + (f" · {fmt_dur(best['duration_min'])}" if best.get("duration_min") else ""),
        f"最贵    {worst['depart']} 走  {money(worst['floor'], currency)}"
        f"  贵 {spread:.0f}%（差 {money(worst['floor'] - best['floor'], currency)}）",
        f"中位 {money(statistics.median(floors), currency)}"
        f" · {len(valid)}/{len(series)} 个行程有报价"
        + (f" · {missing} 个失败" if missing else ""),
    ]
    notes = [price_note(one_way, adults, children, seat), *warnings]
    parts += ["", "## 注意" if md else "注意", ""] + [f"- {n}" for n in notes]
    return "\n".join(parts)


SEATS_INV = {v: k for k, v in SEATS.items()}


