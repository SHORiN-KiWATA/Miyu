              "International Airport in Shanghai. Select flight")
    # 换机场中转是另一套句式，单独回归 —— 只测 "layover at" 那版的话，
    # "layover in … Transfer here from …" 挂掉时 doctor 依然全绿。
    xfer_sample = ("From 6607 Chinese yuan round trip total. 1 stop flight with "
                   "EVA Air. Leaves Shanghai Pudong International Airport at "
                   "8:05\u202fPM on Thursday, October 1 and arrives at Haneda "
                   "Airport at 11:30\u202fAM on Friday, October 2. Total duration "
                   "14 hr 25 min.  Layover (1 of 1) is a 9 hr 20 min layover in "
                   "Taipei City. Transfer here from Taiwan Taoyuan International "
                   "Airport to Taipei Songshan Airport. Select flight")
    it = parse_card(sample, "CNY", date(2026, 10, 1))
    bad = []
    xf = parse_card(xfer_sample, "CNY", date(2026, 10, 1))
    if not xf or xf.layovers != [(560, "Taipei City", True)]:
        bad.append(f"换机场中转实得 {xf.layovers if xf else None}")
    if not it:
        bad.append("整条解析不出来")
    else:
        for field, want in (("price", 5677.0), ("stops", 1), ("duration_min", 1340)):
            got = getattr(it, field)
            if got != want:
                bad.append(f"{field} 期望 {want} 实得 {got}")
        if it.airlines != ["China Eastern", "Air France"]:
            bad.append(f"airlines 实得 {it.airlines}")
        if it.layovers != [(300, "Shanghai", False)]:
            bad.append(f"layovers 实得 {it.layovers}")
        if not it.dep_at or it.dep_at.strftime("%Y-%m-%d %H:%M") != "2026-10-01 13:30":
            bad.append(f"dep_at 实得 {it.dep_at}")
    if bad:
        ok = False
        print(f"解析器      ❌ {len(bad)} 项对不上：{'；'.join(bad)}")
        print("            下一步：Google 改了 aria-label 句式，更新 _L_* 正则")
    else:
        print("解析器      ✅ 金标准样本七个字段全对")

    stale = stale_help_flags()
    if stale:
        ok = False
        print(f"帮助文本    ❌ 提到了 {len(stale)} 个不存在的参数（改名忘了改文档）")
        for flag, line in sorted(stale.items()):
            print(f"            {flag}  (L{line})")
    else:
        print("帮助文本    ✅ 提到的参数都真实存在")
    return 0 if ok else 1


# ---------------------------------------------------------------- 参数

ACTIONS = ("search", "sweep", "trend", "airports", "doctor")

EPILOG = """\
查票通常只要三样 —— 从哪、到哪、哪天走：
  flight-deals -f 上海 -t 东京 -d 2026-10-01 -r 2026-10-07
  flight-deals -f 上海 -t 东京 -d +30              默认往返，玩 7 天
  flight-deals -f 上海 -t 东京 -d +30 --one-way    单程
  flight-deals -f 上海 -t 东京 -d +30 --nonstop --seat business

其他功能各是一个动作：
  flight-deals sweep -f 上海 -t 东京 -w 09-29..10-08 --days 5-7
                                        窗口里哪天走哪天回最便宜
  flight-deals trend -f 上海 -t 东京    这条航线底价这几天涨还是跌
  flight-deals trend                    历史库里攒了哪些航线
  flight-deals airports 东京            东京有哪些机场、三字码是什么
  flight-deals doctor                   环境自检

参数全是具名的，位置无关；动作省略时默认 search，写在哪都认。
日期三种写法：2026-10-15 / 10-15(过了就算明年) / +7(7 天后)
出发地和目的地必须写明，脚本不猜 —— 猜错了输出看起来完全正常。
"""


def build_parser():
    ap = argparse.ArgumentParser(
        prog="flight-deals",
        description="查两地之间的机票价格，扫日期窗口找最便宜的走法。",
        formatter_class=argparse.RawDescriptionHelpFormatter, epilog=EPILOG)
    sub = ap.add_subparsers(dest="cmd", metavar="<动作>")

    def route(g, required=True):
        g.add_argument("-f", "--from", "--origin", dest="origin",
                       required=required, metavar="<出发地>",
                       help="出发城市或机场，如 上海 / Shanghai / PVG。必填，不猜")
        g.add_argument("-t", "--to", "--dest", "--destination", dest="dest",
                       required=required, metavar="<目的地>",
                       help="目的城市或机场，如 东京 / Tokyo / NRT。必填，不猜")

    def who(g):
        g.add_argument("--adults", type=int, default=1, metavar="<人数>",
                       help="成人数（默认 1）")
        g.add_argument("--children", type=int, default=0, metavar="<人数>",
                       help="2-11 岁儿童数（默认 0）")
        g.add_argument("--seat", choices=tuple(SEATS), default="economy",
                       metavar="<舱位>",
                       help="economy/premium/business/first（默认 economy）")

    def filt(g):
        g.add_argument("--nonstop", action="store_true", help="只看直飞")
        g.add_argument("--max-stops", type=int, default=None, metavar="<次数>",
                       help="最多转几次（--nonstop 等同 0）")

    def money_opts(g):
        g.add_argument("--currency", default="CNY", metavar="<币种>",
                       help="币种（默认 CNY）")
        g.add_argument("--region", default="us", metavar="<地区码>",
                       help="Google 地区码（默认 us；一般不用改）")

    def output(g):
        # 定在子命令上而不是顶层：这样 `-f 上海 --json` 这种自然写法能用，
        # argparse 的顶层选项必须写在子命令前面，太反直觉。
        g.add_argument("--format", choices=("auto", "table", "md", "json"),
                       default="auto", metavar="<格式>",
                       help="table/md/json；默认 auto=终端出表格、管道出 markdown")
        g.add_argument("--json", dest="as_json", action="store_true",
                       help="等同 --format json")

    # ---- search：从哪、到哪、哪天走
    s = sub.add_parser(
        "search", help="查指定日期的航班和价格（默认动作）",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        description="查指定日期的航班，按价格排序。\n"
                    "通常只要 --from / --to / --depart 三个参数，默认往返玩 7 天。")
    g = s.add_argument_group("核心参数（通常只用这三个）")
    route(g)
    g.add_argument("-d", "--depart", type=parse_day, metavar="<日期>",
                   help="出发日（默认 14 天后）")
    g = s.add_argument_group("可选")
    g.add_argument("-r", "--return", dest="ret", type=parse_day, metavar="<日期>",
                   help="返程日（默认出发后 --days 天）")
    g.add_argument("--days", metavar="<天数>",
                   help="玩几天，用来算返程日（默认 7）。给了 --return 就不用它")
    g.add_argument("--one-way", action="store_true", help="只查单程")
    who(g)
    filt(g)
    money_opts(g)
    g.add_argument("--top", type=int, default=15, metavar="<条数>",
                   help="显示几条（默认 15）")
    g.add_argument("--limit", type=int, default=60, metavar="<条数>",
                   help="最多取几条（默认 60）")
    g.add_argument("--no-fold", action="store_true",
                   help="不折叠同价同航司的不同起飞时刻，每个时刻各占一行")
    g.add_argument("--no-record", action="store_true", help="不写价格历史")
    output(g)
    s.set_defaults(func=cmd_search)

    # ---- sweep：不知道哪天走划算，扫一个窗口
    w = sub.add_parser(
        "sweep", help="扫一个日期窗口，看哪天走哪天回最便宜",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        description="在一个日期窗口内滑动行程，找最便宜的走法。\n"
                    "例：国庆能出门的日子是 9/29~10/8，想玩 5 到 7 天 ——\n"
                    "  sweep -f 上海 -t 东京 -w 09-29..10-08 --days 5-7\n"
                    "返程日必须也落在窗口内（窗口 = 这段时间我能出门）。")
    g = w.add_argument_group("核心参数")
    route(g)
    g.add_argument("-w", "--window", type=parse_window, metavar="<起..止>",
                   help="日期窗口，如 09-29..10-08（默认 14 天后起的两周）")
    g.add_argument("--days", metavar="<天数>",
                   help="玩几天，可给区间，如 5 或 5-7（默认 5-7）。--one-way 时忽略")
    g = w.add_argument_group("可选")
    g.add_argument("--one-way", action="store_true",
                   help="只扫单程（这时只枚举出发日）")
    who(g)
    filt(g)
    money_opts(g)
    g.add_argument("--workers", type=int, default=6, metavar="<并发>",
                   help="并发请求数（默认 6）")
    g.add_argument("--max-queries", type=int, default=60, metavar="<上限>",
                   help="最多查几个行程，超了直接报错而不是闷头跑（默认 60）")
    g.add_argument("--no-record", action="store_true", help="不写价格历史")
    output(g)
    w.set_defaults(func=cmd_sweep)

    # ---- trend：看攒下来的历史
    t = sub.add_parser(
        "trend", help="看某条航线底价的涨跌；不给航线就列出所有航线",
        description="看同一航线的底价随观测时间怎么变。需要先攒几天数据。\n"
                    "不给 --from/--to 时列出历史库里有哪些航线。")
    g = t.add_argument_group("参数")
    route(g, required=False)
    g.add_argument("-d", "--depart", type=parse_day, metavar="<日期>",
                   help="只看某个出发日的历史")
    output(g)
    t.set_defaults(func=cmd_trend)

    # ---- airports：查三字码
    ar = sub.add_parser("airports", help="查地名对应的机场和三字码",
                        description="查一个地名对应哪些机场。精确命中就列出该城市"
                                    "全部机场，否则按子串给候选。")
    ar.add_argument("query_pos", nargs="?", metavar="<关键词>",
                    help="地名或三字码，如 东京 / Tokyo / NRT")
    ar.add_argument("-q", "--query", metavar="<关键词>",
                    help="同上（给程序调用用；命令行直接写在动作后面即可）")
    output(ar.add_argument_group("可选"))
    ar.set_defaults(func=cmd_airports)

    d = sub.add_parser("doctor", help="环境自检",
                       description="检查 Google 源能不能抓、解析器有没有被改版打挂、"
                                   "帮助文本里的参数是否都还存在。")
    d.set_defaults(func=cmd_doctor, format="table", as_json=False)
    return ap


def option_strings(ap, values_only=False):
    """把 parser 里的选项名全捞出来。

    从 parser 自己身上问，比在别处手抄一份选项表可靠 —— 加了新选项不会忘同步。
    values_only=True 时只要「后面得跟一个值」的那些，用来在 normalize_argv 里
    分辨某个词是动作还是选项的值（`--to search`）。
    """
    flags, stack = set(), [ap]
    while stack:
        cur = stack.pop()
        for act in cur._actions:
            if isinstance(act, argparse._SubParsersAction):
                stack.extend(act.choices.values())
            elif act.option_strings and not (values_only and act.nargs == 0):
                flags.update(act.option_strings)
    return flags


def value_flags(ap):
    return option_strings(ap, values_only=True)


def normalize_argv(argv, ap):
    """把动作词挪到最前面，没写动作就补 search。

    argparse 要求子命令必须是第一个词，但既然对外说了「参数位置无关」，
    动作也该随便放。省略时默认 search，让最常用的操作能写成
    `flight-deals -f 上海 -t 东京 -d +30`。
    """
    if not argv or argv[0] in ACTIONS or argv[0] in ("-h", "--help"):
        return argv

    vflags = value_flags(ap)
    skip_next, action, rest = False, None, []
    for tok in argv:
        if skip_next:                       # 这个词是上一个选项的值，别当动作
            skip_next = False
        elif tok in vflags:
            skip_next = True
        elif action is None and tok in ACTIONS:
            action = tok
            continue
        rest.append(tok)
    return [action or "search"] + rest


# ---------------------------------------------------------------- 程序调用入口

def json_keys(ap):
    """从 parser 反推 {参数名: (flag, 是不是开关)}。

    跟 option_strings() 一个道理：现问 parser 要，而不是在别处手抄一份，
    这样加了新选项、改了名字，JSON 入口不会悄悄跟 CLI 走散。
    """
    keys, stack = {}, [ap]
    while stack:
        cur = stack.pop()
        for act in cur._actions:
            if isinstance(act, argparse._SubParsersAction):
                stack.extend(act.choices.values())
                continue
            for flag in act.option_strings:
                if flag.startswith("--") and flag != "--help":
                    keys.setdefault(flag[2:].replace("-", "_"), (flag, act.nargs == 0))
            if act.dest and act.dest not in ("help", argparse.SUPPRESS):
                for flag in act.option_strings:
                    if flag.startswith("--"):
                        keys.setdefault(act.dest, (flag, act.nargs == 0))
                        break
    return keys


def argv_from_json(payload, ap):
    """把 {"origin": "上海", "dest": "东京"} 摊成一行 argv。

    工具层（Miyu 之类）调脚本时是把参数打成 JSON 从 stdin 喂进来的，argv 是空的。
    没有这个入口，脚本会当成「没给动作」直接打印帮助然后退出 —— 更糟的是退出码 0，
    调用方拿到一坨帮助文本还以为查询成功了。
    """
    if not isinstance(payload, dict):
        raise Failed("stdin 里的 JSON 得是一个对象",
                     '例如 {"origin": "上海", "dest": "东京", "depart": "+30"}')

    known = json_keys(ap)
    action = payload.get("action") or payload.get("cmd") or "search"
    if action not in ACTIONS:
        raise Failed(f"未知动作 {action!r}", f"可选：{'、'.join(ACTIONS)}")

    argv, unknown = [action], []
    for key, val in payload.items():
        if key in ("action", "cmd") or val is None:
            continue
        hit = known.get(key) or known.get(str(key).replace("-", "_"))
        if hit is None:
            unknown.append(key)
            continue
        flag, is_switch = hit
        if is_switch:                       # store_true：给了真值才带上这个 flag
            if val:
                argv.append(flag)
            continue
        vals = val if isinstance(val, (list, tuple)) else [val]
        argv.append(flag)
        argv.extend(str(v) for v in vals)

    if unknown:
        # 静默忽略拼错的参数最坑：调用方以为限定生效了，其实拿的是默认值的结果。
        guess = ", ".join(sorted(known)[:12])
        raise Failed(f"不认识这些参数：{', '.join(map(repr, unknown))}",
                     f"可用参数有 {guess} 等；完整列表跑 doctor 或看 --help")
    return argv


def read_json_stdin():
    """stdin 上有 JSON 就取回来，没有则返回 None（照常走 CLI）。"""
    if sys.stdin is None or sys.stdin.isatty():
        return None
    raw = sys.stdin.read().strip()
    if not raw:
        return None
    try:
        return json.loads(raw)
    except json.JSONDecodeError as exc:
        raise Failed(f"stdin 不是合法 JSON：{exc}",
                     '喂一个对象进来，例如 {"origin": "上海", "dest": "东京"}')


# 这些 -- 开头的词是给别的程序用的，不是本脚本的参数
EXTERNAL_FLAGS = {"--nocapture", "-m"}


def stale_help_flags():
    """揪出帮助文本/提示语里提到、但 parser 根本没有的参数。

    改参数名忘了改文档是个反复犯的错，而且只有用户撞上才会发现 ——
    所以让 doctor 每次都对一遍。

    只扫面向用户的字符串：help=/description=/epilog、print() 的内容、
    报错提示、以及模块开头的用法块。函数自己的 docstring 是写给改代码的人看的，
    里面举例用的参数名不该被当成承诺，跳过。
    """
    tree = ast.parse(open(__file__, encoding="utf-8").read())
    internal = set()
    for node in ast.walk(tree):
        if isinstance(node, (ast.FunctionDef, ast.AsyncFunctionDef, ast.ClassDef)):
            doc = node.body[0] if node.body else None
            if isinstance(doc, ast.Expr) and isinstance(doc.value, ast.Constant):
                internal.add(id(doc.value))

    known = option_strings(build_parser()) | {"-h", "--help"} | EXTERNAL_FLAGS
    stale = {}
    for node in ast.walk(tree):
        if not (isinstance(node, ast.Constant) and isinstance(node.value, str)):
            continue
        if id(node) in internal:
            continue
        for tok in re.split(r"[\s（）()「」,，;；:：/、]+", node.value):
            tok = tok.rstrip(".。!！?？")
            if re.fullmatch(r"--?[a-zA-Z][\w-]*", tok) and tok not in known:
                stale.setdefault(tok, node.lineno)
    return stale


def main():
    ap = build_parser()
    argv = sys.argv[1:]
    try:
        if not argv:
            payload = read_json_stdin()
            if payload is not None:
                argv = argv_from_json(payload, ap)
    except Failed as exc:
        print(f"失败：{exc}", file=sys.stderr)
        if exc.hint:
            print(f"下一步：{exc.hint}", file=sys.stderr)
        return 1

    argv = normalize_argv(argv, ap)
    if not argv:
        ap.print_help()
        return 2

    a = ap.parse_args(argv)
    if getattr(a, "as_json", False):
        a.format = "json"
    if getattr(a, "format", "auto") == "auto":
        a.format = "table" if sys.stdout.isatty() else "md"

    try:
        return a.func(a)
    except Failed as exc:
        print(f"失败：{exc}", file=sys.stderr)
        if exc.hint:
            print(f"下一步：{exc.hint}", file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        print("\n中断", file=sys.stderr)
        return 130


if __name__ == "__main__":
    sys.exit(main())
