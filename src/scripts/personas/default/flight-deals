def parse_day(s):
    """接受 2026-10-15、10-15，或 +7(从今天起 N 天后)。"""
    s = str(s).strip()
    if s.startswith("+"):
        try:
            return date.today() + timedelta(days=int(s[1:]))
        except ValueError:
            raise argparse.ArgumentTypeError(f"看不懂的日期：{s}（+7 表示 7 天后）")
    for fmt in ("%Y-%m-%d", "%Y/%m/%d", "%m-%d", "%m/%d"):
        try:
            d = datetime.strptime(s, fmt).date()
        except ValueError:
            continue
        if "%Y" not in fmt:
            d = d.replace(year=date.today().year)
            if d < date.today():
                d = d.replace(year=d.year + 1)
        return d
    raise argparse.ArgumentTypeError(
        f"看不懂的日期：{s}（能写 2026-10-15、10-15、或 +7 表示 7 天后）")


def parse_window(s):
    """接受 09-29..10-08 / 2026-09-29..2026-10-08 / +30..+45。"""
    parts = re.split(r"\.\.|~|到", str(s).strip())
    if len(parts) != 2:
        raise argparse.ArgumentTypeError(
            f"看不懂的窗口：{s}（写成 起始..结束，例如 09-29..10-08）")
    start, end = parse_day(parts[0]), parse_day(parts[1])
    if end < start:
        raise argparse.ArgumentTypeError(f"窗口结束 {end} 早于开始 {start}")
    return (start, end)


def parse_days(s):
    """接受 5 或 5-7(玩 5 到 7 天都看看)。返回天数列表。"""
    s = str(s).strip()
    if m := re.fullmatch(r"(\d+)\s*[-~]\s*(\d+)", s):
        a, b = int(m.group(1)), int(m.group(2))
        if a > b:
            a, b = b, a
        if b - a > 30:
            raise argparse.ArgumentTypeError(f"天数区间 {s} 太宽了，最多跨 30 天")
        return list(range(a, b + 1))
    if s.isdigit():
        return [int(s)]
    raise argparse.ArgumentTypeError(f"看不懂的天数：{s}（写 5 或 5-7）")


def resolve_pair(a):
    return resolve(a.origin, "出发地"), resolve(a.dest, "目的地")


def passthrough_warnings(*places):
    return [f"「{p.query}」不在内置机场表里，按 IATA 码 {p.codes[0]} 直接查的；"
            "如果结果不是你要的城市，换个写法或核对三字码。"
            for p in places if p.passthrough]


def seat_of(a):
    return SEATS[a.seat]


def cmd_search(a):
    origin, dest = resolve_pair(a)
    depart = a.depart or date.today() + timedelta(days=14)
    days = parse_days(a.days) if a.days else [7]
    if len(days) > 1:
        raise Failed(f"search 的 --days 只能给一个数字，你给了 {a.days}",
                     f"想一次比几种时长，用 sweep：sweep -f {a.origin} -t {a.dest}"
                     f" -w {depart}..{depart + timedelta(days=max(days) + 3)}"
                     f" --days {a.days}")
    ret = None if a.one_way else (a.ret or depart + timedelta(days=days[0]))
    if ret is not None and ret <= depart:
        raise Failed(f"返程日 {ret} 不晚于出发日 {depart}",
                     "去掉 --return 改用 --days，或加 --one-way 查单程")
    if depart < date.today():
        raise Failed(f"出发日 {depart} 已经过去了", "查未来的日期，或写 +14 表示两周后")

    max_stops = 0 if a.nonstop else a.max_stops
    seat = seat_of(a)
    itins = google_search(origin, dest, depart, ret, seat, a.adults, a.children,
                          a.currency, max_stops, a.limit, a.region)
    if not a.no_fold:
        itins = fold(itins)
    url = flights_url(origin, dest, depart, ret, seat, a.adults, a.children,
                      a.currency, max_stops, a.region)
    if not itins:
        raise Failed(f"{origin.label} → {dest.label} 在 {depart} 没有可售航班",
                     "换个日期，或去掉 --nonstop 让中转航班也进来")

    warnings = passthrough_warnings(origin, dest)
    print(render_search(itins, origin, dest, depart, ret, seat, a.adults,
                        a.children, a.currency, a.top, a.format, url, warnings))
    if not a.no_record:
        n = record(origin, dest, itins, seat, a.adults)
        print(f"\n已记录 {n} 条到价格历史", file=sys.stderr)
    return 0


def cmd_sweep(a):
    origin, dest = resolve_pair(a)
    window = a.window or (date.today() + timedelta(days=14),
                          date.today() + timedelta(days=28))
    if window[1] < date.today():
        raise Failed(f"窗口 {window[0]}..{window[1]} 整个都在过去", "查未来的日期")
    days = parse_days(a.days) if a.days else [5, 6, 7]
    trips = plan_trips(window, days, a.one_way)
    if not trips:
        span = (window[1] - window[0]).days
        raise Failed(
            f"窗口只有 {span + 1} 天，装不下 {min(days)} 天的行程",
            f"把窗口拉长(-w {window[0]}..{window[0] + timedelta(days=max(days) + 2)})"
            "，或把 --days 改小")
    if len(trips) > a.max_queries:
        raise Failed(
            f"这个窗口要查 {len(trips)} 个行程，超过上限 {a.max_queries}",
            "缩小 --window、把 --days 收成单个数字，或调大 --max-queries")

    seat = seat_of(a)
    max_stops = 0 if a.nonstop else a.max_stops
    quiet = a.format == "json" or not sys.stderr.isatty()

    def progress(done, total):
        if not quiet:
            print(f"\r扫描中… {done}/{total}", end="", file=sys.stderr, flush=True)

    series = sweep(origin, dest, trips, seat, a.adults, a.children, a.currency,
                   max_stops, a.workers, progress)
    if not quiet:
        print("\r" + " " * 28 + "\r", end="", file=sys.stderr, flush=True)

    warnings = passthrough_warnings(origin, dest)
    print(render_sweep(series, origin, dest, window, a.one_way, seat, a.adults,
                       a.children, a.currency, a.format, warnings))
    if not a.no_record:
        with db() as conn:
            now = datetime.now(timezone.utc).isoformat(timespec="seconds")
            key = route_key(origin, dest)
            conn.executemany(
                "INSERT INTO observations (observed_at, route, origin, dest,"
                " depart, ret, one_way, seat, adults, currency, price, stops,"
                " airlines, duration_min) VALUES (?,?,?,?,?,?,?,?,?,?,?,?,?,?)",
                [(now, key, origin.label, dest.label, d["depart"].isoformat(),
                  d["ret"].isoformat() if d["ret"] else None,
                  1 if a.one_way else 0, seat, a.adults, a.currency, d["floor"],
                  d.get("stops"), d.get("airlines"), d.get("duration_min"))
                 for d in series if d["floor"] is not None])
        print(f"\n已记录 {sum(1 for d in series if d['floor'] is not None)}"
              " 条到价格历史", file=sys.stderr)
    return 0


def cmd_trend(a):
