SESSION_PATH = os.path.join(CACHE_DIR, "session.json")


def migrate_legacy_cache():
    """把旧的 ~/.local/share/goofish 搬到缓存目录。

    只在用默认路径、且新位置还不存在时做一次——会话快照过期只是重新初始化,
    但监控票据丢了就是真丢了。
    """
    if os.environ.get("MIYU_SCRIPT_CACHE_DIR") or os.environ.get("XDG_CACHE_HOME"):
        return
    if os.path.isdir(CACHE_DIR) or not os.path.isdir(LEGACY_CACHE_DIR):
        return
    try:
        os.makedirs(os.path.dirname(CACHE_DIR), exist_ok=True)
        shutil.move(LEGACY_CACHE_DIR, CACHE_DIR)
    except Exception:
        pass  # 搬不动就用新目录从头来,不该因为搬家失败卡住整个脚本
SESSION_TTL = 25 * 60  # 会话快照有效期
COOLDOWN = 180  # RGV587 冷却秒数
