# ---------------------------------------------------------------- 环境

def find_system_chromium():
    for name in ("google-chrome", "google-chrome-stable", "chromium",
                 "chromium-browser", "microsoft-edge", "microsoft-edge-stable"):
        p = shutil.which(name)
        if p:
            return name, p
    return None, None


def playwright_available():
    try:
        import playwright  # noqa: F401
        return True
    except ImportError:
        return False


def chromium_bundled():
    cache = os.path.expanduser("~/.cache/ms-playwright")
    return os.path.isdir(cache) and any(d.startswith("chromium") for d in os.listdir(cache))


def load_session():
    """读取会话快照(25分钟内有效), 延续同一设备指纹"""
    try:
        st = json.load(open(SESSION_PATH))
        if time.time() - st.get("saved_at", 0) > SESSION_TTL:
            return None
        return st.get("storage_state")
    except Exception:
        return None


def save_session(ctx):
    """保存会话快照, 供下次搜索延续指纹"""
    try:
        os.makedirs(CACHE_DIR, exist_ok=True)
        json.dump({"saved_at": int(time.time()), "storage_state": ctx.storage_state()},
                  open(SESSION_PATH, "w"))
    except Exception:
        pass


def session_age():
    try:
        st = json.load(open(SESSION_PATH))
        return int(time.time() - st.get("saved_at", 0))
    except Exception:
        return None


# ---------------------------------------------------------------- 进度日志 / 动画

QUIET = False  # --json 模式下置 True: 静默所有 stderr 日志, stdout 保持纯 JSON


def log(msg):
    """带时间戳的进度日志, 输出到 stderr, 不污染 stdout 的 JSON 结果"""
    if QUIET:
        return
    print(f"[{time.strftime('%H:%M:%S')}] {msg}", file=sys.stderr, flush=True)


class Spinner:
    """阻塞等待时的秒数动画(stderr), 不干扰 Playwright 主线程; 非TTY环境退化为单行提示"""

    def __init__(self, label):
        self.label = label
        self._stop = threading.Event()
        self._t = None

    def __enter__(self):
        if QUIET:
            return self
        start = time.monotonic()
        if not sys.stderr.isatty():
            print(f"  … {self.label} ...", file=sys.stderr, flush=True)
            return self

        def run():
            chars = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"
            i = 0
            while not self._stop.is_set():
                el = int(time.monotonic() - start)
                print(f"\r  {chars[i % len(chars)]} {self.label} {el}s", end="", file=sys.stderr, flush=True)
                i += 1
                self._stop.wait(0.2)
            print(f"\r  ✓ {self.label} {int(time.monotonic() - start)}s", file=sys.stderr, flush=True)

        self._t = threading.Thread(target=run, daemon=True)
        self._t.start()
        return self

    def __exit__(self, *exc):
        self._stop.set()
        if self._t:
            self._t.join(timeout=0.5)


# ---------------------------------------------------------------- 浏览器搜索

def browser_search(keyword: str, capture_to=None, max_items=30, max_pages=1):
    """打开闲鱼搜索页, 关弹窗后重搜, 捕获搜索接口 JSON, 支持翻页。返回 (items, ticket|None)"""
    from playwright.sync_api import sync_playwright

    items, ticket = [], None
    with sync_playwright() as p:
        launch_kw = dict(headless=os.environ.get("XY_HEADED") != "1", args=["--no-sandbox"])
        if shutil.which("google-chrome") or shutil.which("google-chrome-stable"):
            launch_kw["channel"] = "chrome"
        elif shutil.which("microsoft-edge") or shutil.which("microsoft-edge-stable"):
            launch_kw["channel"] = "msedge"
        elif chromium_bundled():
            launch_kw["channel"] = "chromium"
        else:
            # channel="chromium" 只指 playwright 自带的构建; 系统 chromium
            # (pacman 等安装) 必须走 executable_path, 否则 preflight 通过但启动失败
            _, sys_path = find_system_chromium()
            if sys_path:
                launch_kw["executable_path"] = sys_path
            else:
                launch_kw["channel"] = "chromium"
        b = p.chromium.launch(**launch_kw)
        log("Chromium 已启动 (headless)" if launch_kw.get("headless") else "Chromium 已启动 (有头, XY_HEADED=1)")
        session = load_session()
        if session:
            log("复用上次会话(同设备指纹)")
        ctx = b.new_context(
            user_agent=UA,
            viewport={"width": 1280, "height": 900},
            locale="zh-CN",
            timezone_id="Asia/Shanghai",
            storage_state=session or None,
        )
        pg = ctx.new_page()
        payloads = {}  # pageNumber -> 响应JSON
        pending = {}   # 请求url -> pageNumber
        captured_req = {}

        def on_req(r):
            if SEARCH_API + "/1.0" in r.url and "h5api.m.goofish.com" in r.url:
                captured_req.update({
                    "method": r.method,
                    "url": r.url,
                    "post_data": r.post_data,
                    "headers": {k.lower(): v for k, v in r.headers.items()},
                    "cookies": {c["name"]: c["value"] for c in ctx.cookies()},
                })
                try:
                    pd = urllib.parse.parse_qs(r.post_data or "")["data"][0]
                    pending[r.url] = int(json.loads(pd).get("pageNumber", 1))
                except Exception:
                    pending[r.url] = 1

        def on_resp(r):
            if SEARCH_API + "/1.0" in r.url:
                page = pending.pop(r.url, 1)
                try:
                    t = r.text()
                except Exception:
                    return
                if '"SUCCESS' in t:
                    payloads[page] = json.loads(t)

        pg.on("request", on_req)
        pg.on("response", on_resp)
        log(f"打开搜索页: 关键词「{keyword}」")
        pg.goto(f"https://www.goofish.com/search?q={urllib.parse.quote(keyword)}",
                timeout=60000, wait_until="domcontentloaded")
        # 参数化: XY_INIT_WAIT(前置等待), XY_RETRY_INTERVAL(重试间隔), XY_FIXED_WAIT=1(旧固定时序)
        init_wait = float(os.environ.get("XY_INIT_WAIT", "2"))
        retry_interval = float(os.environ.get("XY_RETRY_INTERVAL", "3"))
        fixed_wait = os.environ.get("XY_FIXED_WAIT") == "1"
        deadline = time.monotonic() + 30
        attempt = 0
        with Spinner("搜索中(自动重试)"):
            while 1 not in payloads and time.monotonic() < deadline:
                attempt += 1
                if fixed_wait and attempt == 1:
                    pg.wait_for_timeout(15000)
                elif attempt == 1:
                    pg.wait_for_timeout(int(init_wait * 1000))
                try:
                    if pg.locator(".login-pop-close").count() > 0 and pg.locator(".login-pop-close").first.is_visible():
                        pg.locator(".login-pop-close").first.click(timeout=2000)
                        log("已关闭登录弹窗")
                except Exception:
                    pass
                if 1 not in payloads:
                    try:
                        box = pg.locator("input").first
                        box.fill(keyword)
                        box.press("Enter")
                        if attempt > 1:
                            log(f"重新触发搜索(第{attempt}次)")
                    except Exception:
                        pass
                # 事件驱动等待: 每 0.5s 检查成功 flag, 到了立即结束
                waited = 0.0
                while 1 not in payloads and waited < (15.0 if fixed_wait else retry_interval) \
                        and time.monotonic() < deadline:
                    pg.wait_for_timeout(500)
                    waited += 0.5
        # 翻页: 点击页码, 事件驱动等待对应页响应
        got_pages = 1
        while got_pages < max_pages and 1 in payloads:
            has_next = payloads.get(got_pages, {}).get("data", {}).get("resultInfo", {}).get("hasNextPage")
            if not has_next:
                log(f"已无更多页(共{got_pages}页)")
                break
            target = got_pages + 1
            try:
                pg.wait_for_selector("[class*='search-pagination-page-box']", timeout=5000)
            except Exception:
                log("分页控件未渲染, 停止翻页")
                break
            box = (pg.locator("[class*='search-pagination-page-box']")
                   .filter(has_text=re.compile(f"^{target}$")))
            if box.count() == 0:
                log(f"第{target}页按钮不存在, 停止翻页")
                break
            try:
                box.first.evaluate("e => e.click()")
            except Exception:
                log(f"第{target}页点击失败, 停止翻页")
                break
            pdline = time.monotonic() + 10
            while target not in payloads and time.monotonic() < pdline:
                pg.wait_for_timeout(500)
            if target in payloads:
                got_pages = target
                log(f"已获取第{got_pages}页")
            else:
                log(f"第{target}页无响应, 停止翻页")
                break
        if 1 in payloads:
            save_session(ctx)
        b.close()

    if 1 not in payloads:
        raise RuntimeError("RGV587::风控拦截(被挤爆啦)或未获取到搜索结果, 请等约3分钟后重试")
    log("搜索接口响应成功")

    seen_ids = set()
    for page in sorted(payloads):
        for rl in payloads[page]["data"]["resultList"]:
            it = rl["data"]["item"]
            ex = it.get("main", {}).get("exContent", {})
            num, unit = "", 1
            for s in ex.get("price") or []:
                t = s.get("text", "")
                if s.get("type") == "integer":
                    num = t
                elif s.get("type") == "decimal":
                    num += t
                elif s.get("type") == "unit" and t == "万":
                    unit = 10000
            item_id = ex.get("itemId") or it.get("item_id") or ""
            if item_id in seen_ids:
                continue
            seen_ids.add(item_id)
            items.append({
                "id": item_id,
                "title": (ex.get("title") or "").strip(),
                "price": int(round(float(num) * unit)) if num else (it.get("displayPrice") or ""),
                "area": ex.get("area") or "",
                "url": f"https://www.goofish.com/item?id={item_id}" if item_id else "",
            })
            if len(items) >= max_items * max_pages:
                break
        if len(items) >= max_items * max_pages:
            break
    if capture_to and captured_req:
        ticket = {
            "keyword": keyword,
            "captured_at": int(time.time()),
            "request": captured_req,
        }
        os.makedirs(os.path.dirname(capture_to), exist_ok=True)
        with open(capture_to, "w") as f:
            json.dump(ticket, f, ensure_ascii=False, indent=1)
    return items, ticket


# ---------------------------------------------------------------- 纯HTTP票据重放

def ticket_path(keyword):
    h = hashlib.md5(keyword.encode()).hexdigest()[:12]
    return os.path.join(CACHE_DIR, f"{h}.json")


def http_query(keyword: str, max_items=30, retries=3, cooldown=COOLDOWN):
    """用票据纯HTTP重放。票据与关键词绑定。"""
    path = ticket_path(keyword)
    if not os.path.exists(path):
        raise RuntimeError(f"没有关键词「{keyword}」的票据, 请先运行: goofish monitor-init \"{keyword}\"")
    ticket = json.load(open(path))
    c = ticket["request"]
    if "post_data" not in c:
        raise RuntimeError("票据格式不正确")
    data = urllib.parse.parse_qs(c["post_data"])["data"][0]

    # 校验签名(自检)
    qs = urllib.parse.parse_qs(urllib.parse.urlparse(c["url"]).query)
    token = c["cookies"].get("_m_h5_tk", "").split("_")[0]
    calc = hashlib.md5(f"{token}&{qs['t'][0]}&{APP_KEY}&{data}".encode()).hexdigest()
    if calc != qs["sign"][0]:
        raise RuntimeError("票据签名自检失败, 请重新 monitor-init")

    CK = "; ".join(f"{k}={v}" for k, v in c["cookies"].items())
    for attempt in range(retries):
        req = urllib.request.Request(c["url"], data=urllib.parse.urlencode({"data": data}).encode(),
            headers={"User-Agent": c["headers"]["user-agent"], "Referer": "https://www.goofish.com/",
                     "Accept": "application/json", "Accept-Language": "zh-CN",
                     "Content-Type": "application/x-www-form-urlencoded", "Cookie": CK})
        try:
            r = json.loads(urllib.request.urlopen(req, timeout=20).read().decode())
        except Exception as e:
            raise RuntimeError(f"请求失败: {e}")
        ret = (r.get("ret") or [""])[0]
        if ret.startswith("SUCCESS"):
            items = []
            for rl in r["data"]["resultList"]:
                ex = rl["data"]["item"]["main"]["exContent"]
                num, unit = "", 1
                for s in ex.get("price") or []:
                    t = s.get("text", "")
                    if s.get("type") == "integer":
                        num = t
                    elif s.get("type") == "decimal":
                        num += t
                    elif s.get("type") == "unit" and t == "万":
                        unit = 10000
                item_id = ex.get("itemId") or ""
                items.append({
                    "id": item_id,
                    "title": (ex.get("title") or "").strip(),
                    "price": int(round(float(num) * unit)) if num else "",
                    "area": ex.get("area") or "",
                    "url": f"https://www.goofish.com/item?id={item_id}" if item_id else "",
                })
                if len(items) >= max_items:
                    break
            return items
        if attempt + 1 < retries:
            print(f"  第{attempt+1}次被拦({ret[:60]}), 冷却{cooldown}s后重试", file=sys.stderr)
            time.sleep(cooldown)
        else:
            print(f"  第{attempt+1}次被拦({ret[:60]})", file=sys.stderr)
    raise RuntimeError("多次被风控拦截, 会话可能已失效, 请重新 monitor-init")


# ---------------------------------------------------------------- 输出

def render(items, keyword, as_json):
    if as_json:
        print(json.dumps({"keyword": keyword, "count": len(items), "items": items},
                         ensure_ascii=False, indent=1))
        return
    print(f"共 {len(items)} 条 · 关键词: {keyword}")
    for it in items:
        price = f"¥{it['price']:,}" if isinstance(it["price"], int) else it["price"]
        print(f"{price:<10} {it['area']:<8} {(it['title'] or '')[:40]}")
        if it["url"]:
            print(f"  {it['url']}")


# ---------------------------------------------------------------- doctor / setup / preflight

def preflight():
    """依赖/环境预检, 返回 (ok, 问题列表)"""
    problems = []
    if not playwright_available():
        problems.append("playwright 未安装 → 运行: goofish setup (或 sudo pacman -S python-playwright)")
    if not chromium_bundled() and not find_system_chromium()[0]:
        problems.append("没有可用浏览器(需 Chromium 系) → 运行: goofish setup (或 sudo pacman -S chromium)")
    if problems:
        return False, problems
    return True, []


def fail_preflight(probs, as_json=False):
    """依赖缺失时的统一出口: 错误 + 自动诊断 + 修复提示"""
    if as_json:
        print(json.dumps({"error": "依赖未就绪", "problems": probs,
                          "fix": "goofish setup"}, ensure_ascii=False))
        for p in probs:
            print(f"❌ {p}", file=sys.stderr)
    else:
        for p in probs:
            print(f"❌ {p}", file=sys.stderr)
        print("\n-- 自动环境自检 --")
        doctor()
        print("提示: 运行 `goofish setup` 自动安装缺失依赖", file=sys.stderr)
    sys.exit(1)


def doctor():
    print("== goofish 环境自检 ==")
    print(f"python3: {sys.version.split()[0]}")
    print(f"playwright: {'✅' if playwright_available() else '❌ 未安装(运行 goofish setup)'}")
    bundled = chromium_bundled()
    sys_name, sys_path = find_system_chromium()
    print(f"chromium(playwright内置): {'✅' if bundled else '❌'}")
    print(f"chromium(系统): {'✅ ' + sys_name + ' @ ' + sys_path if sys_path else '❌'}")
    if not bundled and not sys_path:
        print("  → 需要浏览器, 运行 goofish setup")
    print("无头模式: ✅ headless 内置, 无需显示器/xvfb")
    age = session_age()
    if age is None:
        print("会话快照: 无 (首次搜索后自动创建)")
    elif age > SESSION_TTL:
        print(f"会话快照: ⚠️ 已过期 ({age}s 前保存, 将重新初始化)")
    else:
        print(f"会话快照: ✅ 有效 ({age}s 前保存)")
    tickets = [f for f in os.listdir(CACHE_DIR) if f.endswith(".json")] if os.path.isdir(CACHE_DIR) else []
    print(f"监控票据: {len(tickets)} 个")
    for t in tickets:
        try:
            tk = json.load(open(os.path.join(CACHE_DIR, t)))
            print(f"  - {tk['keyword']} (签发于 {time.strftime('%m-%d %H:%M', time.localtime(tk['captured_at']))})")
        except Exception:
            pass


def setup():
    ok = True
    if not playwright_available():
        print("[1/2] 安装 playwright (阿里云镜像)...")
        cmds = [
            [sys.executable, "-m", "pip", "install", "--user", "--break-system-packages",
             "playwright", "-i", "https://mirrors.aliyun.com/pypi/simple/"],
            [sys.executable, "-m", "pip", "install", "--user", "playwright",
             "-i", "https://mirrors.aliyun.com/pypi/simple/"],
            [sys.executable, "-m", "pip", "install", "--user", "--break-system-packages", "playwright"],
        ]
        for c in cmds:
            try:
                r = subprocess.run(c, capture_output=True, text=True, timeout=600)
                if r.returncode == 0:
                    break
            except Exception:
                continue
        else:
            print("  pip 安装失败, Arch 可用: sudo pacman -S python-playwright")
            ok = False
    if not chromium_bundled():
        sys_name, _ = find_system_chromium()
        if sys_name:
            print(f"[2/2] 检测到系统浏览器 {sys_name}, 可复用, 跳过下载")
        else:
            print("[2/2] 下载 Chromium (约160MB, 国内走 npmmirror)...")
            env = dict(os.environ)
            env["PLAYWRIGHT_DOWNLOAD_HOST"] = "https://npmmirror.com/mirrors/playwright/"
            r = subprocess.run([sys.executable, "-m", "playwright", "install", "chromium"],
                               env=env, capture_output=True, text=True, timeout=900)
            if r.returncode != 0:
                print(r.stderr[-500:])
                print("  也可: sudo pacman -S chromium 然后复用系统浏览器")
                ok = False
    print("安装后复检:")
    good, probs = preflight()
    if good:
        print("  全部就绪 ✅")
    else:
        print("  仍有问题 ❌")
        for p in probs:
            print("   " + p)
        ok = False
    print("完成 ✅" if ok else "部分失败, 请按提示处理 ❌")


# ---------------------------------------------------------------- Miyu stdin-JSON 模式

def doctor_text():
    """捕获 doctor() 输出为字符串(供 JSON 错误附带)"""
    import io
    buf = io.StringIO()
    old = sys.stdout
    try:
        sys.stdout = buf
        doctor()
    finally:
        sys.stdout = old
    return buf.getvalue()


def stdin_json_mode():
    """Miyu script 工具入口: 无命令行参数且 stdin 为 JSON 时启用。
    输入: {"action": "search"|"monitor-init"|"monitor-query", "keyword": "...", "pages": N}
    输出: 纯 JSON(stdout), 进度静默。"""
    global QUIET
    QUIET = True

    def die(msg, extra=None):
        out = {"error": msg}
        if extra:
            out.update(extra)
        print(json.dumps(out, ensure_ascii=False))
        sys.exit(1)

    raw = sys.stdin.read().strip()
    if not raw:
        die("未收到输入: 请通过 stdin 传入 JSON, 如 {\"keyword\": \"RTX 4060\"}")
    try:
        req = json.loads(raw)
    except Exception:
        die("stdin 不是有效 JSON")
    keyword = str(req.get("keyword") or req.get("query") or "").strip()
    action = str(req.get("action") or "search").strip()
    if not keyword:
        die("keyword 参数缺失")
    if action not in ("search", "monitor-init", "monitor-query"):
        die(f"未知 action: {action} (可选 search / monitor-init / monitor-query)")

    if action in ("search", "monitor-init"):
        good, probs = preflight()
        if not good:
            die("依赖未就绪", {"problems": probs,
                              "fix": "运行 goofish-search setup 自动安装, 或按 problems 提示手动安装",
                              "doctor": doctor_text()})
        try:
            if action == "search":
                pages = max(1, min(int(req.get("pages") or 1), 10))
                items, _ = browser_search(keyword, max_pages=pages)
            else:
                items, _ = browser_search(keyword, capture_to=ticket_path(keyword))
        except RuntimeError as e:
            die(str(e))
        except Exception as e:
            die(f"浏览器执行失败: {e}", {"doctor": doctor_text()})
        out = {"keyword": keyword, "count": len(items), "items": items}
        if action == "monitor-init":
            out["ticket"] = ticket_path(keyword)
            out["hint"] = "票据已签发, 之后可用 action=monitor-query 秒级查询该关键词"
        print(json.dumps(out, ensure_ascii=False, indent=1))
    else:
        try:
            # 工具调用场景不做长冷却重试(会顶到脚本超时), 快速失败并提示
            items = http_query(keyword, retries=1)
        except RuntimeError as e:
            die(str(e))
        except Exception as e:
            die(f"查询失败: {e}")
        print(json.dumps({"keyword": keyword, "count": len(items), "items": items},
                         ensure_ascii=False, indent=1))


# ---------------------------------------------------------------- main

KNOWN_CMDS = {"search", "monitor-init", "monitor-query", "doctor", "setup"}


def main():
    global QUIET
    migrate_legacy_cache()  # 必须在任何读写缓存之前
    # Miyu script 工具模式: 无参数 + stdin 非终端 → 按 stdin JSON 处理
    if len(sys.argv) == 1 and not sys.stdin.isatty():
        stdin_json_mode()
        return
    # 裸关键词自动补子命令: goofish "关键词" 等价于 goofish search "关键词"
    argv = sys.argv[1:]
    for i, a in enumerate(argv):
        if not a.startswith("-"):
            if a not in KNOWN_CMDS:
                argv = argv[:i] + ["search"] + argv[i:]
            break
    ap = argparse.ArgumentParser(
        description="闲鱼免登录商品搜索 (无需API/登录)。直接给关键词即默认搜索: goofish \"关键词\"",
        epilog="示例: goofish \"RTX 5090\" | goofish search \"RTX 5090\" --json | goofish monitor-query \"RTX 5090\"",
    )
    sub = ap.add_subparsers(dest="cmd")
    p1 = sub.add_parser("search", help="临时搜索(浏览器, 约5-15s, 30条/页)")
    p1.add_argument("keyword")
    p1.add_argument("--json", action="store_true", help="JSON 输出(供AI解析), 同时静默日志")
    p1.add_argument("--pages", type=int, default=1, help="翻页数量(1-50, 默认1, 每页30条)")
    p2 = sub.add_parser("monitor-init", help="为关键词签发监控票据(浏览器, 一次, 约5-15s)")
    p2.add_argument("keyword")
    p3 = sub.add_parser("monitor-query", help="纯HTTP查询已签发的关键词(零浏览器, 秒级)")
    p3.add_argument("keyword")
    p3.add_argument("--json", action="store_true", help="JSON 输出(供AI解析)")
    sub.add_parser("doctor", help="环境自检")
    sub.add_parser("setup", help="安装缺失依赖")
    args = ap.parse_args(argv)

    if args.cmd is None:
        ap.print_help()
        sys.exit(2)

    if getattr(args, "json", False) and os.environ.get("XY_VERBOSE") != "1":
        QUIET = True

    if args.cmd == "doctor":
        doctor()
        return
    if args.cmd == "setup":
        setup()
        return

    if args.cmd == "search":
        good, probs = preflight()
        if not good:
            fail_preflight(probs, as_json=args.json)
        pages = max(1, min(args.pages, 50))
        t0 = time.monotonic()
        log(f"开始搜索「{args.keyword}」({pages}页)")
        try:
            items, _ = browser_search(args.keyword, max_pages=pages)
        except RuntimeError:
            raise
        except Exception as e:
            print(f"❌ 浏览器执行失败: {e}", file=sys.stderr)
            print("   提示: 运行 `goofish doctor` 查看环境; 系统库缺失参考 README 依赖清单", file=sys.stderr)
            sys.exit(1)
        log(f"搜索完成, 用时 {int(time.monotonic() - t0)}s")
        render(items, args.keyword, args.json)
    elif args.cmd == "monitor-init":
        good, probs = preflight()
        if not good:
            fail_preflight(probs, as_json=False)
        t0 = time.monotonic()
        log(f"开始签发票据「{args.keyword}」")
        try:
            items, _ = browser_search(args.keyword, capture_to=ticket_path(args.keyword))
        except RuntimeError:
            raise
        except Exception as e:
            print(f"❌ 浏览器执行失败: {e}", file=sys.stderr)
            print("   提示: 运行 `goofish doctor` 查看环境; 系统库缺失参考 README 依赖清单", file=sys.stderr)
            sys.exit(1)
        log(f"票据已保存: {ticket_path(args.keyword)}, 用时 {int(time.monotonic() - t0)}s")
        render(items, args.keyword, False)
    elif args.cmd == "monitor-query":
        items = http_query(args.keyword)
        render(items, args.keyword, args.json)


if __name__ == "__main__":
    try:
        main()
    except RuntimeError as e:
        print(f"❌ {e}", file=sys.stderr)
        sys.exit(1)
