def parse_language(value):
    return value if value in ("zh", "en") else "bilingual"


def select_topic(topic, query):
    if topic != "auto" and topic != "":
        if topic in TOPICS:
            return topic
        raise Failed(f"unsupported fcitx wiki topic: {topic}", "topic 只认 auto/" + "/".join(TOPICS))
    lower = query.lower()
    if "xim" in lower or "xmodifiers" in lower or "xwayland" in lower:
        return "xim"
    if "electron" in lower or "chromium" in lower or "wechat" in lower:
        return "electron_chromium"
    if "gtk" in lower or "gtk_im_module" in lower:
        return "gtk"
    if "qt" in lower or "qt_im_module" in lower or "qt_im_modules" in lower:
        return "qt"
    if "lc_ctype" in lower or "locale" in lower or "lang" in lower:
        return "locale"
    if "wayland" in lower or "text-input" in lower or "ozone" in lower:
        return "wayland"
    if "setup" in lower or "install" in lower or "配置" in lower:
        return "setup"
    return "for_users"


def page_for_topic(topic):
    if topic in ("home", "for_users"):
        return PAGE_FCITX5
    if topic == "setup":
        return PAGE_SETUP
    if topic in ("wayland", "electron_chromium"):
        return PAGE_WAYLAND
    if topic in ("environment_variables", "xim", "gtk", "qt", "locale"):
        return PAGE_ENV
    return PAGE_FCITX5


def bilingual(language, zh, en):
    if language == "zh":
        return {"zh": zh}
    if language == "en":
        return {"en": en}
    return {"zh": zh, "en": en}


def claims_for_topic(topic, language):
    return [
        {
            "claim": bilingual(language, zh, en),
            "applies_to": applies_to,
            "confidence": "official_wiki_general_rule",
            "caveat": caveat,
        }
        for zh, en, applies_to, caveat in CLAIMS.get(topic, [])
    ]


# ---------------------------------------------------------------- page excerpt

def _describe(exc):
    if isinstance(exc, urllib.error.HTTPError):
        return f"HTTP status error ({exc.code} {exc.reason}) for url ({exc.url})"
    if isinstance(exc, urllib.error.URLError):
        return f"error sending request: {exc.reason}"
    if isinstance(exc, (TimeoutError, socket.timeout)):
        return f"request timed out after {TIMEOUT}s"
    return str(exc)


def read_text(url, max_bytes):
    req = urllib.request.Request(url, headers={"User-Agent": USER_AGENT})
    with urllib.request.urlopen(req, timeout=TIMEOUT) as resp:
        body = resp.read(max_bytes + 1)
    if len(body) > max_bytes:
        raise Failed("response too large (exceeds configured byte limit)")
    return body.decode("utf-8", "ignore")


def extract_mw_parser_output(html_text):
    """只取 mw-parser-output 那个 div 的内容（按 <div/</div 计深度），找不到返回 None。"""
    marker = "mw-parser-output"
    start = html_text.find(marker)
    if start < 0:
        return None
    open_angle = html_text.find(">", start)
    if open_angle < 0:
        return None
    rest = html_text[open_angle + 1:]
    depth = 1
    for m in re.finditer(r"</?div", rest):
        if m.group(0) == "</div":
            depth -= 1
            if depth == 0:
                return rest[:m.start()]
        else:
            depth += 1
    return None


def clip(value):
    if len(value) <= MAX_EXCERPT_CHARS:
        return value
    return f"{value[:MAX_EXCERPT_CHARS]}\n...[truncated to {MAX_EXCERPT_CHARS} chars]"


def fetch_page_excerpt(url):
    try:
        html_text = read_text(url, MAX_PAGE_BYTES)
    except Failed:
        raise
    except Exception as exc:  # noqa: BLE001
        raise Failed(_describe(exc)) from exc
    body = extract_mw_parser_output(html_text)
    markdown = html_to_markdown(body if body is not None else html_text)
    return clip(markdown)


# ---------------------------------------------------------------- output

def format_zh_wrapped_response(response, language):
    claims = []
    for item in response["claims"]:
        value = {
            "结论": item["claim"].get("zh", ""),
            "适用范围": item["applies_to"],
            "可信度": item["confidence"],
            "注意事项": item["caveat"],
        }
        if language == "bilingual":
            value["english_reference"] = item["claim"].get("en", "")
        claims.append(value)
    output = {
        "状态": response["ok"],
        "工具": response["tool"],
        "说明": "这是 Fcitx5 官方 Wiki 专用查询工具；中文为主包装，英文保留为原文参考。",
        "命名备注": "工具名按用户要求保留 qurey 拼写。",
        "主题": response["topic"],
        "查询": response["query"],
        "来源": {"标题": response["source"]["title"], "URL": response["source"]["url"]},
        "官方规则摘录": claims,
        "诊断使用规则": response["diagnostic_rule"].get("zh", ""),
        "页面摘录": response["page_excerpt"],
    }
    if language == "bilingual":
        output["diagnostic_rule_en"] = response["diagnostic_rule"].get("en", "")
    # Rust 侧 json!{} 走 BTreeMap，键按字节序输出；sort_keys 按码点排序，对 UTF-8 等价。
    return json.dumps(output, ensure_ascii=False, indent=2, sort_keys=True)


def query(args):
    q = (args.get("query") if isinstance(args.get("query"), str) else "").strip()
    topic_arg = (args.get("topic") if isinstance(args.get("topic"), str) else "auto").strip()
    language = parse_language(args.get("language") if isinstance(args.get("language"), str) else "bilingual")
    include = args.get("include_page_excerpt")
    include_page_excerpt = include if isinstance(include, bool) else True
    topic = select_topic(topic_arg, q)
    title, url = page_for_topic(topic)
    response = {
        "ok": True,
        "tool": TOOL_NAME,
        "spelling_note": "Tool name keeps the requested 'qurey' spelling for compatibility.",
        "topic": topic,
        "query": q or None,
        "source": {"title": title, "url": url},
        "claims": claims_for_topic(topic, language),
        "diagnostic_rule": bilingual(language, *DIAGNOSTIC_RULE),
        "page_excerpt": None,
    }
    if include_page_excerpt:
        try:
            response["page_excerpt"] = fetch_page_excerpt(url)
        except Exception as exc:  # noqa: BLE001 —— 摘录失败不致命，与 Rust 一致
            response["page_excerpt"] = f"[fetch failed: {exc}]"
    if language == "en":
        return json.dumps(response, ensure_ascii=False, indent=2)
    return format_zh_wrapped_response(response, language)


def read_args():
    raw = os.environ.get("MIYU_ARGS_JSON")
    if not raw:
        if sys.stdin is None or sys.stdin.isatty():
            raw = "{}"
        else:
            raw = sys.stdin.read() or "{}"
    try:
        args = json.loads(raw)
    except json.JSONDecodeError as exc:
        raise Failed(f"arguments are not valid JSON: {exc}", '喂一个对象，例如 {"topic":"xim"}') from exc
    if not isinstance(args, dict):
        raise Failed("arguments must be a JSON object", '例如 {"topic":"xim"}')
    return args


def main():
    try:
        print(query(read_args()))
    except Failed as exc:
        fail(exc, exc.fix)
    except Exception as exc:  # noqa: BLE001 —— 工具层不该看到 traceback
        fail(f"{type(exc).__name__}: {exc}", "稍后再试")


if __name__ == "__main__":
    main()
