{
  "name": "web_search",
  "trust": "external",
  "display_name": "网络搜索",
  "description": "Search the web. When your reply draws on the results, end it with the sources you used, one per line, as `title (url)`.",
  "parameters": {
    "type": "object",
    "properties": {
      "query": {
        "type": "string"
      },
      "max_results": {
        "type": "integer"
      }
    }
  },
  "permission": "readonly",
  "always_loaded": true,
  "load_policy": "summary",
  "groups": [
    "web"
  ]
}
