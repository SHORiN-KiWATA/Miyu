{
  "name": "manage_meme",
  "display_name": "管理表情包",
  "description": "Manage this persona's meme library. action=add imports a local image, action=update edits metadata in the writable overlay, action=delete removes a user meme or disables a built-in one; only hard_delete=true deletes the file permanently.",
  "parameters": {
    "type": "object",
    "properties": {
      "action": {
        "type": "string",
        "enum": [
          "add",
          "update",
          "delete"
        ],
        "description": "add imports, update edits metadata, delete removes."
      },
      "image": {
        "type": "string",
        "description": "add: local image path."
      },
      "id": {
        "type": "string",
        "description": "update/delete: full sha256 id or a unique short id."
      },
      "library": {
        "type": "string",
        "description": "Optional meme library override."
      },
      "name_zh": {
        "type": "string",
        "description": "Chinese name."
      },
      "name_en": {
        "type": "string",
        "description": "English name."
      },
      "description": {
        "type": "string",
        "description": "Description of the visible content."
      },
      "usage": {
        "type": "string",
        "description": "When to use it."
      },
      "tags": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "description": "Search tags."
      },
      "enabled": {
        "type": "boolean",
        "description": "update: enable or disable."
      },
      "hard_delete": {
        "type": "boolean",
        "description": "delete: permanently delete instead of moving to the recycle bin."
      }
    },
    "required": [
      "action"
    ],
    "additionalProperties": false
  },
  "always_loaded": false,
  "load_policy": "group",
  "groups": [
    "memes"
  ]
}
